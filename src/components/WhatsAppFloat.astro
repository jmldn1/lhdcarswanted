---
// The round WhatsApp button, bottom right on every public page, as on London
// LHD Centre v1. Shown when the brand has a WhatsApp number. On a car's page
// the message starts with the car's name and the page's address.
import { brand } from "../brands/index.ts";

interface Props {
  /** The car the page is about ("Porsche 911 GT3 RS"). */
  car?: string;
}
const { car } = Astro.props;
const number = brand.contact.whatsapp;
const label = car ? `Ask about the ${car} on WhatsApp` : `Message ${brand.name} on WhatsApp`;
const href = `https://wa.me/${number}${car ? `?text=${encodeURIComponent(car)}` : ""}`;
---

{number && (
  <a class="wa" href={href} target="_blank" rel="noopener" aria-label={label} data-car={car}>
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.601 2.326A7.96 7.96 0 0 0 8.003 0C3.58 0 .035 3.54.035 7.907c0 1.394.372 2.75 1.076 3.94L0 16l4.263-1.106a8.047 8.047 0 0 0 3.74.949h.003c4.422 0 7.968-3.539 7.968-7.906a7.868 7.868 0 0 0-2.373-5.611ZM8.003 14.5a6.64 6.64 0 0 1-3.386-.926l-.242-.143-2.53.654.675-2.464-.158-.253a6.542 6.542 0 0 1-.999-3.46c0-3.605 2.956-6.54 6.597-6.54a6.576 6.576 0 0 1 4.678 1.933 6.506 6.506 0 0 1 1.92 4.607c0 3.604-2.957 6.542-6.575 6.542Zm3.605-4.879c-.197-.098-1.172-.578-1.353-.644-.18-.066-.313-.099-.445.099-.132.198-.511.644-.625.777-.115.132-.23.148-.428.049-.198-.098-.838-.31-1.596-.99-.59-.525-.988-1.174-1.104-1.373-.115-.198-.012-.305.086-.403.088-.088.198-.23.297-.345.099-.116.132-.198.198-.33.066-.132.033-.248-.017-.347-.049-.099-.445-1.072-.61-1.47-.16-.39-.323-.337-.445-.343-.115-.006-.248-.007-.38-.007s-.347.049-.53.248c-.182.198-.695.678-.695 1.654 0 .975.712 1.917.812 2.05.099.132 1.4 2.14 3.393 3.002.474.204.843.326 1.131.417.475.151.908.13 1.25.079.381-.057 1.172-.479 1.338-.942.165-.462.165-.858.116-.942-.049-.083-.18-.132-.377-.23Z" /></svg>
  </a>
)}

<script>
  // The address comes from the browser: behind nginx the server may not know it.
  const a = document.querySelector<HTMLAnchorElement>(".wa[data-car]");
  if (a) {
    const url = new URL(a.href);
    url.search = `?text=${encodeURIComponent(`${a.dataset.car}: ${location.origin}${location.pathname}`)}`;
    a.href = url.href;
  }
</script>

<style>
  .wa {
    position: fixed;
    right: max(16px, env(safe-area-inset-right, 0px));
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    /* WhatsApp's green, dark enough for the white icon to stand out (3:1). */
    background: #1da851;
    color: #fff;
    box-shadow: 0 6px 14px rgb(0 0 0 / 0.25);
  }
  .wa:hover {
    background: #17883f;
  }
  .wa:focus-visible {
    outline: 3px solid var(--color-fg);
    outline-offset: 2px;
  }
  .wa svg {
    width: 28px;
    height: 28px;
    fill: currentColor;
  }
  /* Phones: above the Call bar on pages that have one (71px tall). */
  @media (max-width: 639px) {
    :global(body:has(.call-bar)) .wa {
      bottom: calc(80px + env(safe-area-inset-bottom, 0px));
    }
  }
  @media print {
    .wa {
      display: none;
    }
  }
</style>
