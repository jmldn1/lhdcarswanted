---
// A car's description on its page: paragraphs, "Highlights" as a small
// heading and its points as a list (src/lib/description.ts). Text size comes
// from the parent.
import { descriptionBlocks } from "../lib/description.ts";

interface Props {
  text: string;
}
const blocks = descriptionBlocks(Astro.props.text);
---

<div class="desc">
  {blocks.map((b) =>
    b.type === "p" ? (
      <p>{b.text}</p>
    ) : b.type === "label" ? (
      <h3>{b.text}</h3>
    ) : (
      <ul>
        {b.items.map((item) => <li>{item}</li>)}
      </ul>
    ),
  )}
</div>

<style>
  .desc {
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow-wrap: anywhere;
  }
  p,
  ul {
    margin: 0;
  }
  p {
    white-space: pre-line;
  }
  h3 {
    margin: 6px 0 -6px;
    font: 700 13px/1.3 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  ul {
    display: grid;
    gap: 6px;
    padding: 0;
    list-style: none;
  }
  li {
    position: relative;
    padding-left: 22px;
  }
  /* A small accent square for each point. */
  li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 7px;
    height: 7px;
    background: var(--color-accent);
  }
</style>
