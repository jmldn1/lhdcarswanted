---
// The admin's add/edit car form, from the admin mockups: photos first, then
// the details and description, and beside them "On the site" and the price.
//
// Photos: new ones go up with the form (a new car), or straight away when
// chosen (a car being edited, with JavaScript), and are made web-ready in
// the background; this page checks every few seconds and adds them as they
// finish. Order is set by dragging, or with the arrows (phones); the first
// is the cover. Removing is a tick, applied on Save.
import type { Car } from "../../lib/cars.ts";
import type { CarErrors } from "../../lib/car-form.ts";
import { pick } from "../../lib/photos.ts";
import { aiReady } from "../../lib/ai.ts";
import { FLAGS } from "../../lib/flags.ts";

interface Props {
  car: Car;
  errors: CarErrors;
  featured: boolean;
  mode: "new" | "edit";
  refused?: string[];
}
const { car, errors, featured, mode, refused = [] } = Astro.props;
const err = (k: keyof CarErrors) => errors[k];
const STATUS: [Car["status"], string, string][] = [
  ["draft", "Draft", "Not on the site yet. Only you can see it here."],
  ["available", "For sale", "On the site and in the cars list."],
  ["reserved", "Reserved", "Stays on the site with a Reserved label."],
  ["sold", "Sold", "Stays on the site with a Sold label."],
];
const pending = car.pending ?? [];
// The AI buttons show only when it's set up (ANTHROPIC_API_KEY).
const ai = aiReady();
const described = car.photos.filter((p) => p.alt).length;
---

<form method="post" enctype="multipart/form-data" class="car-form" data-mode={mode} data-car={car.id} novalidate>
  <input type="hidden" name="intent" value="save" />

  <section class="admin-box" aria-labelledby="ph-h">
    <div class="ph-head">
      <h2 id="ph-h">Photos <span class="count">{car.photos.length}{pending.length ? ` · ${pending.length} on the way` : ""}</span></h2>
      <p class="a-hint">Drag, or use the arrows, to change the order. The first photo is the cover. Photos are kept whole, never cropped.</p>
    </div>

    <div class="pickers">
      <label class="a-btn pri picker">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg>
        Take a photo
        <input type="file" name="photos" accept="image/*" capture="environment" />
      </label>
      <label class="a-btn picker">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 16v3h16v-3M12 4v11M7 9l5-5 5 5" /></svg>
        Choose photos
        <input type="file" name="photos" accept="image/*" multiple />
      </label>
      <span class="chosen a-hint" aria-live="polite"></span>
    </div>
    {mode === "new" && <p class="a-hint">Up to 20 photos (30 MB each) upload when you save, then are made web-ready in the background. Add more after saving.</p>}
    {refused.length > 0 && <p class="a-err" role="alert">Not added: {refused.join("; ")}</p>}
    {err("photos") && <p class="a-err" role="alert">{err("photos")}</p>}

    <input type="hidden" name="order" value={car.photos.map((p) => p.id).join(",")} />
    <ol class="photos">
      {car.photos.map((p, i) => (
        <li class="ph" draggable="true" data-id={p.id} title={p.alt}>
          <img src={pick(p.avif, 300).url} alt={`Photo ${i + 1}`} loading="lazy" />
          <span class="num" aria-hidden="true">{i + 1}</span>
          <span class="cover">Cover</span>
          <span class="tools">
            <button type="button" class="mv" data-dir="-1" aria-label="Move earlier">‹</button>
            <button type="button" class="mv" data-dir="1" aria-label="Move later">›</button>
          </span>
          <label class="rm"><input type="checkbox" name="remove" value={p.id} /> Remove</label>
        </li>
      ))}
      {pending.map((p) => (
        <li class="ph busy" data-pending={p.id}>
          <span>Making web-ready…</span>
          <span class="bar" aria-hidden="true"><i></i></span>
          <span class="file">{p.name}</span>
        </li>
      ))}
    </ol>
    {ai && mode === "edit" && car.photos.length > 0 && (
      <div class="ai-row">
        <button type="button" class="a-btn ai-btn" id="ai-alt" disabled={described === car.photos.length}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z" /></svg>
          <span class="ai-label">Describe the photos with AI</span>
        </button>
        <span class="a-hint" id="ai-alt-status" aria-live="polite">{described} of {car.photos.length} described (for screen readers and Google). New photos are described as they're added; point at a photo to see its text.</span>
      </div>
    )}
  </section>

  <div class="cols">
    <div class="col-main">
      <section class="admin-box" aria-labelledby="d-h">
        <h2 id="d-h">Details</h2>
        <div class="grid2">
          <div>
            <label class="a-lbl" for="f-make">Make</label>
            <input class="a-in" id="f-make" name="make" value={car.make} required aria-invalid={err("make") ? "true" : undefined} aria-describedby={err("make") ? "f-make-err" : undefined} />
            {err("make") && <p class="a-err" id="f-make-err">{err("make")}</p>}
          </div>
          <div>
            <label class="a-lbl" for="f-model">Model</label>
            <input class="a-in" id="f-model" name="model" value={car.model} required aria-invalid={err("model") ? "true" : undefined} aria-describedby={err("model") ? "f-model-err" : undefined} />
            {err("model") && <p class="a-err" id="f-model-err">{err("model")}</p>}
          </div>
          <div>
            <label class="a-lbl" for="f-year">Year</label>
            <input class="a-in" id="f-year" name="year" inputmode="numeric" maxlength="4" value={car.year} aria-invalid={err("year") ? "true" : undefined} aria-describedby={err("year") ? "f-year-err" : undefined} />
            {err("year") && <p class="a-err" id="f-year-err">{err("year")}</p>}
          </div>
          <div>
            <label class="a-lbl" for="f-miles">Mileage</label>
            <input class="a-in" id="f-miles" name="mileage" value={car.mileage} placeholder="17,000 miles" />
          </div>
          <div>
            <label class="a-lbl" for="f-colour">Colour <span class="a-opt">(optional)</span></label>
            <input class="a-in" id="f-colour" name="colour" value={car.colour} />
          </div>
          <div>
            <label class="a-lbl" for="f-reg">Registered in <span class="a-opt">(optional)</span></label>
            <input class="a-in" id="f-reg" name="registered" value={car.registered} list="reg-countries" autocomplete="off" placeholder="UK, Germany, not registered…" />
            <datalist id="reg-countries">{["UK", ...FLAGS.slice(1).map((f) => f.name), "Not registered"].map((n) => <option value={n} />)}</datalist>
          </div>
          <div>
            <label class="a-lbl" for="f-gear">Gearbox <span class="a-opt">(optional)</span></label>
            <select class="a-in" id="f-gear" name="gearbox">
              <option value="">Not set</option>
              <option selected={car.gearbox === "Manual"}>Manual</option>
              <option selected={car.gearbox === "Automatic"}>Automatic</option>
            </select>
          </div>
          <div>
            <label class="a-lbl" for="f-engine">Engine <span class="a-opt">(optional)</span></label>
            <input class="a-in" id="f-engine" name="engine" value={car.engine} placeholder="3.8 litre" />
          </div>
        </div>
        <fieldset>
          <legend class="a-lbl">Steering</legend>
          <div class="a-pills">
            <label class="a-pill"><input type="radio" name="steering" value="LHD" checked={car.steering === "LHD"} /><span>Left hand drive</span></label>
            <label class="a-pill"><input type="radio" name="steering" value="RHD" checked={car.steering === "RHD"} /><span>Right hand drive</span></label>
            <label class="a-pill"><input type="radio" name="steering" value="" checked={!car.steering} /><span>Not set</span></label>
          </div>
        </fieldset>
      </section>

      <section class="admin-box" aria-labelledby="desc-h">
        <h2 id="desc-h">Description</h2>
        <div>
          <label class="a-lbl" for="f-desc">Shown under the photos on the car's page</label>
          <textarea class="a-in" id="f-desc" name="description" rows="7">{car.description}</textarea>
        </div>
        {ai && (
          <>
            <div class="ai-row">
              <button type="button" class="a-btn ai-btn" id="ai-desc">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z" /></svg>
                <span class="ai-label">{car.description ? "Polish with AI" : "Write with AI"}</span>
              </button>
              <button type="button" class="a-btn" id="ai-desc-undo" hidden>Undo</button>
              <label class="check bg-check"><input type="checkbox" id="ai-desc-bg" /> Add model background</label>
              <span class="a-hint" id="ai-desc-status" aria-live="polite"></span>
            </div>
            <p class="a-hint">Type or dictate your notes in any form (history, owners, service, documents, equipment, condition), then <strong>Polish with AI</strong>: it rewrites them keeping every fact and adding nothing, as an opening paragraph, "Highlights:" with a line for each point, and a closing line. With no notes it writes a short description from the details. <strong>Add model background</strong> lets it add a sentence or two about the model in general: check those especially. Check it all before saving.</p>
          </>
        )}
      </section>

      {ai && (
        <section class="admin-box" aria-labelledby="soc-h">
          <h2 id="soc-h">Social media captions</h2>
          <p class="a-hint">Three caption ideas for Instagram or Facebook, from the details and description above. Copy the one you want; nothing is posted or saved.</p>
          <div class="ai-row">
            <button type="button" class="a-btn ai-btn" id="ai-social">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z" /></svg>
              <span class="ai-label">Write captions</span>
            </button>
            <span class="a-hint" id="ai-social-status" aria-live="polite"></span>
          </div>
          <ol class="captions" id="ai-captions"></ol>
        </section>
      )}

      <section class="admin-box" aria-labelledby="vid-h">
        <h2 id="vid-h">Walkaround video <span class="a-opt">(optional)</span></h2>
        <div>
          <label class="a-lbl" for="f-video">Video link</label>
          <input class="a-in" id="f-video" name="videoUrl" type="url" inputmode="url" value={car.video?.url} placeholder="https://youtu.be/…" aria-invalid={err("video") ? "true" : undefined} aria-describedby={err("video") ? "f-video-err f-video-hint" : "f-video-hint"} />
          {err("video") && <p class="a-err" id="f-video-err">{err("video")}</p>}
          <p class="a-hint" id="f-video-hint">A YouTube link (unlisted is fine), a Vimeo link, or the web address of an .mp4 file. Leave empty for no video.</p>
        </div>
        <div class="grid2">
          <div>
            <label class="a-lbl" for="f-vlen">Length <span class="a-opt">(optional)</span></label>
            <input class="a-in" id="f-vlen" name="videoLength" value={car.video?.length} placeholder="2:14" aria-invalid={err("videoLength") ? "true" : undefined} aria-describedby={err("videoLength") ? "f-vlen-err" : undefined} />
            {err("videoLength") && <p class="a-err" id="f-vlen-err">{err("videoLength")}</p>}
          </div>
          {car.photos.length > 0 && (
            <div>
              <label class="a-lbl" for="f-vposter">Poster photo</label>
              <select class="a-in" id="f-vposter" name="videoPoster">
                <option value="">Photo {car.photos.length > 1 ? 2 : 1} (the default)</option>
                {car.photos.map((p, i) => (
                  <option value={p.id} selected={car.video?.poster === p.id}>Photo {i + 1}</option>
                ))}
              </select>
            </div>
          )}
        </div>
        <p class="a-hint">The page shows the poster photo with a play button; the video itself only loads when someone presses play.</p>
      </section>
    </div>

    <div class="col-side">
      <section class="admin-box" aria-labelledby="st-h">
        <h2 id="st-h">On the site</h2>
        <fieldset>
          <legend class="sr">Status</legend>
          <div class="a-pills">
            {STATUS.map(([value, label]) => (
              <label class="a-pill"><input type="radio" name="status" value={value} checked={car.status === value} /><span>{label}</span></label>
            ))}
          </div>
          <ul class="st-hints a-hint">
            {STATUS.map(([value, label, hint]) => <li data-for={value}><strong>{label}:</strong> {hint}</li>)}
          </ul>
        </fieldset>
        <label class="check"><input type="checkbox" name="featured" checked={featured} /> Featured on the homepage</label>
        {car.slug && (
          <div>
            <span class="a-lbl">Web address</span>
            <p class="addr">/cars/{car.slug}</p>
            <p class="a-hint">Kept if you rename the car, so links don't break.</p>
          </div>
        )}
      </section>

      <section class="admin-box" aria-labelledby="pr-h">
        <h2 id="pr-h">Price</h2>
        <div>
          <label class="a-lbl" for="f-price">Price (£)</label>
          <input class="a-in" id="f-price" name="price" inputmode="numeric" value={car.price ?? ""} placeholder="65000" aria-invalid={err("price") ? "true" : undefined} aria-describedby={err("price") ? "f-price-err" : undefined} />
          {err("price") && <p class="a-err" id="f-price-err">{err("price")}</p>}
        </div>
        <label class="check"><input type="checkbox" name="poa" checked={car.price === null && mode === "edit"} /> Price on application (shows POA)</label>
      </section>
    </div>
  </div>

  <div class="save-bar">
    <button class="a-btn pri" type="submit">{mode === "new" ? "Save the car" : "Save changes"}</button>
  </div>
</form>

<script>
  import { askAi, busy } from "../../scripts/admin-ai.ts";

  const form = document.querySelector<HTMLFormElement>(".car-form");
  if (form) {
    const list = form.querySelector<HTMLOListElement>(".photos")!;
    const order = form.querySelector<HTMLInputElement>('input[name="order"]')!;
    const chosen = form.querySelector<HTMLElement>(".chosen")!;
    const carId = form.dataset.car!;
    const editing = form.dataset.mode === "edit";

    // Order: renumber, mark the cover and keep the hidden list in step.
    const sync = () => {
      const tiles = [...list.querySelectorAll<HTMLLIElement>("li[data-id]")];
      tiles.forEach((li, i) => {
        li.querySelector(".num")!.textContent = String(i + 1);
        li.querySelector("img")!.alt = `Photo ${i + 1}`;
      });
      order.value = tiles.map((li) => li.dataset.id).join(",");
    };
    let dragged: HTMLLIElement | null = null;
    list.addEventListener("dragstart", (e) => {
      dragged = (e.target as HTMLElement).closest("li[data-id]");
      dragged?.classList.add("dragging");
    });
    list.addEventListener("dragover", (e) => {
      const over = (e.target as HTMLElement).closest<HTMLLIElement>("li[data-id]");
      if (!dragged || !over || over === dragged) return;
      e.preventDefault();
      const r = over.getBoundingClientRect();
      if (e.clientX > r.left + r.width / 2) over.after(dragged);
      else over.before(dragged);
    });
    list.addEventListener("dragend", () => {
      dragged?.classList.remove("dragging");
      dragged = null;
      sync();
    });
    list.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".mv");
      if (!btn) return;
      const li = btn.closest<HTMLLIElement>("li")!;
      if (btn.dataset.dir === "-1") li.previousElementSibling?.before(li);
      else {
        const next = li.nextElementSibling as HTMLLIElement | null;
        if (next?.dataset.id) next.after(li);
      }
      sync();
      btn.focus();
    });

    // Adds a tile for a photo that has just become web-ready.
    const addTile = (p: { id: string; thumb: string }) => {
      const li = document.createElement("li");
      li.className = "ph";
      li.draggable = true;
      li.dataset.id = p.id;
      li.innerHTML =
        '<img alt=""><span class="num" aria-hidden="true"></span><span class="cover">Cover</span>' +
        '<span class="tools"><button type="button" class="mv" data-dir="-1" aria-label="Move earlier">‹</button>' +
        '<button type="button" class="mv" data-dir="1" aria-label="Move later">›</button></span>' +
        '<label class="rm"><input type="checkbox" name="remove"> Remove</label>';
      li.querySelector("img")!.src = p.thumb;
      li.querySelector<HTMLInputElement>('input[name="remove"]')!.value = p.id;
      const firstBusy = list.querySelector("li.busy");
      firstBusy ? firstBusy.before(li) : list.append(li);
    };
    const busyTile = (id: string, name: string) => {
      const li = document.createElement("li");
      li.className = "ph busy";
      li.dataset.pending = id;
      li.innerHTML = '<span>Making web-ready…</span><span class="bar" aria-hidden="true"><i></i></span><span class="file"></span>';
      li.querySelector(".file")!.textContent = name;
      list.append(li);
      return li;
    };

    // Every few seconds while photos are on the way: add the finished ones.
    let polling = false;
    const poll = async () => {
      if (polling) return;
      polling = true;
      try {
        for (;;) {
          const res = await fetch(`/admin/cars/${carId}/photos`, { headers: { accept: "application/json" } });
          if (!res.ok) break;
          const state: { photos: { id: string; thumb: string }[]; pending: { id: string; name: string }[] } = await res.json();
          const have = new Set([...list.querySelectorAll<HTMLLIElement>("li[data-id]")].map((li) => li.dataset.id));
          state.photos.filter((p) => !have.has(p.id)).forEach(addTile);
          const waiting = new Set(state.pending.map((p) => p.id));
          list.querySelectorAll<HTMLLIElement>("li[data-pending]").forEach((li) => {
            if (!waiting.has(li.dataset.pending!) && !li.dataset.uploading) li.remove();
          });
          sync();
          form.querySelector(".count")!.textContent =
            `${have.size + state.photos.filter((p) => !have.has(p.id)).length}${state.pending.length ? ` · ${state.pending.length} on the way` : ""}`;
          if (!state.pending.length && !list.querySelector("li[data-uploading]")) break;
          await new Promise((r) => setTimeout(r, 2500));
        }
      } finally {
        polling = false;
      }
    };

    form.querySelectorAll<HTMLInputElement>('input[type="file"]').forEach((input) => {
      input.addEventListener("change", async () => {
        const files = [...(input.files ?? [])];
        if (!files.length) return;
        if (!editing) {
          // A new car: they go up with the form.
          const n = [...form.querySelectorAll<HTMLInputElement>('input[type="file"]')].reduce((s, i) => s + (i.files?.length ?? 0), 0);
          chosen.textContent =
            n > 20
              ? `${n} photos chosen: only the first 20 go up with the car. Add the rest after saving.`
              : `${n} ${n === 1 ? "photo" : "photos"} ready to upload with the car`;
          return;
        }
        // Editing: upload now, one at a time, then let the server work.
        for (const f of files) {
          const tile = busyTile(`up-${Math.random()}`, f.name);
          tile.dataset.uploading = "1";
          tile.querySelector("span")!.textContent = "Uploading…";
          const body = new FormData();
          body.append("photos", f);
          const res = await fetch(`/admin/cars/${carId}/photos`, { method: "POST", body, headers: { accept: "application/json" } }).catch(() => null);
          const out = res && (await res.json().catch(() => null));
          tile.remove();
          if (!res?.ok) {
            chosen.textContent = `${f.name} wasn't added${out?.error ? `: ${out.error}` : ""}.`;
            continue;
          }
          for (const p of out.pending as { id: string; name: string }[]) {
            if (!list.querySelector(`li[data-pending="${p.id}"]`)) busyTile(p.id, p.name);
          }
        }
        input.value = "";
        poll();
      });
    });
    if (list.querySelector("li[data-pending]")) poll();

    // The hint under the status shows only for the one chosen.
    const hints = form.querySelectorAll<HTMLElement>(".st-hints li");
    const showHint = () => {
      const v = form.querySelector<HTMLInputElement>('input[name="status"]:checked')?.value;
      hints.forEach((h) => (h.hidden = h.dataset.for !== v));
    };
    form.querySelectorAll('input[name="status"]').forEach((r) => r.addEventListener("change", showHint));
    showHint();

    // POA: the price box is greyed out while it's ticked.
    const poa = form.querySelector<HTMLInputElement>('input[name="poa"]')!;
    const price = form.querySelector<HTMLInputElement>('input[name="price"]')!;
    const syncPoa = () => (price.disabled = poa.checked);
    poa.addEventListener("change", syncPoa);
    syncPoa();

    // AI (shown only when it's set up). The form's values as it would send
    // them, without the photo files.
    const fields = () => {
      const out: Record<string, string> = {};
      for (const [k, v] of new FormData(form)) if (typeof v === "string" && !(k in out)) out[k] = v;
      return out;
    };

    // Description: write from the details, or polish the notes; Undo puts
    // back what was there.
    const descBtn = form.querySelector<HTMLButtonElement>("#ai-desc");
    if (descBtn) {
      const box = form.querySelector<HTMLTextAreaElement>("#f-desc")!;
      const undo = form.querySelector<HTMLButtonElement>("#ai-desc-undo")!;
      const status = form.querySelector<HTMLElement>("#ai-desc-status")!;
      const label = descBtn.querySelector(".ai-label")!;
      const relabel = () => (label.textContent = box.value.trim() ? "Polish with AI" : "Write with AI");
      let before = "";
      box.addEventListener("input", () => {
        relabel();
        undo.hidden = true;
      });
      descBtn.addEventListener("click", () =>
        busy(descBtn, box.value.trim() ? "Polishing…" : "Writing…", status, async () => {
          const background = form.querySelector<HTMLInputElement>("#ai-desc-bg")?.checked ?? false;
          const { description } = await askAi<{ description: string }>({ task: "description", fields: fields(), background });
          before = box.value;
          box.value = description;
          undo.hidden = false;
          return "Done. Check it, then save.";
        }).then(relabel),
      );
      undo.addEventListener("click", () => {
        box.value = before;
        undo.hidden = true;
        status.textContent = "Put back as it was.";
        relabel();
      });
    }

    // Social captions: three to choose from, each with a Copy button.
    const socialBtn = form.querySelector<HTMLButtonElement>("#ai-social");
    if (socialBtn) {
      const status = form.querySelector<HTMLElement>("#ai-social-status")!;
      const list = form.querySelector<HTMLOListElement>("#ai-captions")!;
      socialBtn.addEventListener("click", () =>
        busy(socialBtn, "Writing…", status, async () => {
          const { captions } = await askAi<{ captions: string[] }>({ task: "captions", fields: fields() });
          list.replaceChildren(
            ...captions.map((c) => {
              const li = document.createElement("li");
              const p = document.createElement("p");
              p.textContent = c;
              const copy = document.createElement("button");
              copy.type = "button";
              copy.className = "a-btn";
              copy.textContent = "Copy";
              copy.addEventListener("click", async () => {
                try {
                  await navigator.clipboard.writeText(c);
                  copy.textContent = "Copied";
                } catch {
                  copy.textContent = "Select and copy it";
                }
              });
              li.append(p, copy);
              return li;
            }),
          );
          return "";
        }).then(() => {
          if (list.children.length) socialBtn.querySelector(".ai-label")!.textContent = "Write new ones";
        }),
      );
    }

    // Photo descriptions: written in the background, saved as each is done.
    const altBtn = form.querySelector<HTMLButtonElement>("#ai-alt");
    if (altBtn) {
      const status = form.querySelector<HTMLElement>("#ai-alt-status")!;
      altBtn.addEventListener("click", () =>
        busy(altBtn, "Starting…", status, async () => {
          const { queued } = await askAi<{ queued: number }>({ task: "alt", carId });
          return queued
            ? `Describing ${queued} photo${queued > 1 ? "s" : ""} in the background. Each is saved as it's done; reload the page later to see them.`
            : "Every photo is already described.";
        }),
      );
    }
  }
</script>

