---
// The admin's write/edit post form: title, category, intro, the post (with
// a short formatting guide), cover photo, author, date and Draft/Published.
import type { Post } from "../../lib/blog.ts";
import type { PostErrors } from "../../lib/post-form.ts";
import { pick } from "../../lib/photos.ts";
import { aiReady } from "../../lib/ai.ts";

interface Props {
  post: Post;
  errors: PostErrors;
  categories: string[];
  mode: "new" | "edit";
}
const { post, errors, categories, mode } = Astro.props;
const err = (k: keyof PostErrors) => errors[k];
// The AI box shows only when it's set up (ANTHROPIC_API_KEY).
const ai = aiReady();
const SPARK = "M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z";
---

<form method="post" enctype="multipart/form-data" class="post-form" novalidate>
  <input type="hidden" name="intent" value="save" />
  <div class="cols">
    <div class="col-main">
      <section class="admin-box" aria-labelledby="w-h">
        <h2 id="w-h">The post</h2>
        <div>
          <label class="a-lbl" for="p-title">Title</label>
          <input class="a-in big" id="p-title" name="title" value={post.title} required aria-invalid={err("title") ? "true" : undefined} aria-describedby={err("title") ? "p-title-err" : undefined} />
          {err("title") && <p class="a-err" id="p-title-err">{err("title")}</p>}
        </div>
        <div>
          <label class="a-lbl" for="p-intro">Intro <span class="a-opt">(one sentence, under the title and on the blog page)</span></label>
          <textarea class="a-in" id="p-intro" name="intro" rows="2">{post.intro}</textarea>
        </div>
        <div>
          <label class="a-lbl" for="p-body">The post</label>
          <textarea class="a-in body" id="p-body" name="body" rows="22" aria-invalid={err("body") ? "true" : undefined} aria-describedby={`p-help${err("body") ? " p-body-err" : ""}`}>{post.body}</textarea>
          {err("body") && <p class="a-err" id="p-body-err">{err("body")}</p>}
          <details class="help" id="p-help">
            <summary>Formatting</summary>
            <ul>
              <li>Leave an empty line between paragraphs.</li>
              <li><code>## A heading</code>, <code>### A smaller heading</code></li>
              <li><code>- a point</code> on each line for a list, <code>1. a step</code> for a numbered one</li>
              <li><code>&gt; a line to pull out</code> for a quote</li>
              <li><code>**bold**</code>, <code>_italic_</code>, <code>[link text](https://…)</code></li>
            </ul>
          </details>
        </div>
      </section>
    </div>

    <div class="col-side">
      {ai && (
        <section class="admin-box ai-box" aria-labelledby="ai-h">
          <h2 id="ai-h">Write with AI</h2>
          <p class="a-hint">It fills in the post for you to check; nothing is saved until you save. Anything about the business it doesn't know is left as a [PLACEHOLDER].</p>
          <div class="ai-btns">
            <button type="button" class="a-btn pri" data-mode="draft" title="Write the whole post from the title and your notes in the post box">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={SPARK} /></svg><span class="ai-label">Draft from my notes</span>
            </button>
            <button type="button" class="a-btn" data-mode="polish"><span class="ai-label">Polish</span></button>
            <button type="button" class="a-btn" data-mode="shorten"><span class="ai-label">Shorten</span></button>
            <button type="button" class="a-btn" data-mode="headline"><span class="ai-label">Suggest titles</span></button>
          </div>
          <div class="ai-row">
            <button type="button" class="a-btn" id="ai-undo" hidden>Undo</button>
            <p class="a-hint" id="ai-status" aria-live="polite"></p>
          </div>
          <div id="ai-ideas" hidden>
            <span class="a-lbl">Titles</span>
            <ul class="ideas" id="ai-titles"></ul>
            <span class="a-lbl">Intro</span>
            <ul class="ideas" id="ai-intro"></ul>
          </div>
        </section>
      )}
      <section class="admin-box" aria-labelledby="pub-h">
        <h2 id="pub-h">Publishing</h2>
        <fieldset>
          <legend class="sr">Status</legend>
          <div class="a-pills">
            <label class="a-pill"><input type="radio" name="status" value="draft" checked={post.status === "draft"} /><span>Draft</span></label>
            <label class="a-pill"><input type="radio" name="status" value="published" checked={post.status === "published"} /><span>Published</span></label>
          </div>
          <p class="a-hint">Drafts are only seen here.</p>
        </fieldset>
        <div>
          <label class="a-lbl" for="p-date">Date shown</label>
          <input class="a-in" id="p-date" name="date" type="date" value={post.date} aria-invalid={err("date") ? "true" : undefined} />
          {err("date") && <p class="a-err">{err("date")}</p>}
        </div>
        <div>
          <label class="a-lbl" for="p-cat">Category <span class="a-opt">(optional)</span></label>
          <input class="a-in" id="p-cat" name="category" list="p-cats" value={post.category} placeholder="Selling, Buying…" />
          <datalist id="p-cats">{categories.map((c) => <option value={c} />)}</datalist>
        </div>
        <div>
          <label class="a-lbl" for="p-author">Author <span class="a-opt">(optional)</span></label>
          <input class="a-in" id="p-author" name="author" value={post.author} />
        </div>
        {post.slug && (
          <div>
            <span class="a-lbl">Web address</span>
            <p class="addr">/blog/{post.slug}</p>
          </div>
        )}
      </section>

      <section class="admin-box" aria-labelledby="cov-h">
        <h2 id="cov-h">Cover photo</h2>
        {post.cover && (
          <>
            <img class="cover" src={pick(post.cover.avif, 800).url} alt="The current cover photo" />
            <label class="check"><input type="checkbox" name="removeCover" /> Remove this photo</label>
          </>
        )}
        <div>
          <label class="a-lbl" for="p-cover">{post.cover ? "Replace it" : "Choose a photo"}</label>
          <input id="p-cover" name="cover" type="file" accept="image/*" />
          {err("cover") && <p class="a-err">{err("cover")}</p>}
          <p class="a-hint">Shown wide (16:9) at the top of the post and on its card.</p>
        </div>
      </section>
    </div>
  </div>

  <div class="save-bar">
    <button class="a-btn pri" type="submit">{mode === "new" ? "Save the post" : "Save changes"}</button>
  </div>
</form>

<script>
  import { askAi, busy } from "../../scripts/admin-ai.ts";

  // Write with AI: draft, polish, shorten (each replaces the post, with Undo)
  // or suggest titles and an intro to pick from.
  const box = document.querySelector<HTMLElement>(".ai-box");
  if (box) {
    const title = document.querySelector<HTMLInputElement>("#p-title")!;
    const intro = document.querySelector<HTMLTextAreaElement>("#p-intro")!;
    const body = document.querySelector<HTMLTextAreaElement>("#p-body")!;
    const status = box.querySelector<HTMLElement>("#ai-status")!;
    const undo = box.querySelector<HTMLButtonElement>("#ai-undo")!;
    const ideas = box.querySelector<HTMLElement>("#ai-ideas")!;
    let before: [string, string, string] | null = null;
    const LABEL: Record<string, string> = { draft: "Writing…", polish: "Polishing…", shorten: "Shortening…", headline: "Thinking…" };

    // One suggestion, with a Use button that puts it in the field.
    const idea = (text: string, field: HTMLInputElement | HTMLTextAreaElement) => {
      const li = document.createElement("li");
      const span = document.createElement("span");
      span.textContent = text;
      const use = document.createElement("button");
      use.type = "button";
      use.className = "a-btn";
      use.textContent = "Use";
      use.addEventListener("click", () => {
        before = [title.value, intro.value, body.value];
        field.value = text;
        undo.hidden = false;
        status.textContent = "Done. Check it, then save.";
      });
      li.append(span, use);
      return li;
    };

    box.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const mode = btn.dataset.mode!;
        return busy(btn, LABEL[mode], status, async () => {
          const r = await askAi<{ title?: string; intro?: string; body?: string; titles?: string[] }>({
            task: "blog",
            mode,
            title: title.value,
            intro: intro.value,
            body: body.value,
          });
          if (mode === "headline") {
            box.querySelector("#ai-titles")!.replaceChildren(...(r.titles ?? []).map((t) => idea(t, title)));
            box.querySelector("#ai-intro")!.replaceChildren(...(r.intro ? [idea(r.intro, intro)] : []));
            ideas.hidden = false;
            return "Pick any you like.";
          }
          before = [title.value, intro.value, body.value];
          if (r.title) title.value = r.title;
          if (r.intro) intro.value = r.intro;
          if (r.body) body.value = r.body;
          undo.hidden = false;
          return "Done. Check it, then save.";
        });
      }),
    );
    undo.addEventListener("click", () => {
      if (before) [title.value, intro.value, body.value] = before;
      undo.hidden = true;
      status.textContent = "Put back as it was.";
    });
  }
</script>

<style>
  .ai-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .ai-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }
  .ai-row .a-hint {
    margin: 0;
  }
  #ai-ideas {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  #ai-ideas[hidden] {
    display: none;
  }
  .ideas {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0 0 8px;
    padding: 0;
    list-style: none;
  }
  .ideas li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
  }
  .ideas span {
    flex: 1;
    overflow-wrap: anywhere;
  }
  .post-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: flex-start;
  }
  .col-main {
    flex: 999 1 520px;
    min-width: 0;
  }
  .col-side {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .big {
    font-size: 20px;
    font-weight: 600;
  }
  .body {
    font: 400 16px/1.6 var(--font-body);
  }
  .help {
    margin-top: 8px;
    font-size: 14px;
    color: var(--color-muted);
  }
  .help summary {
    cursor: pointer;
    font-weight: 600;
  }
  .help ul {
    margin: 8px 0 0;
    padding-left: 18px;
  }
  .help code {
    background: var(--color-bg);
    padding: 1px 4px;
  }
  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .addr {
    margin: 0;
    padding: 12px;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    font-size: 14px;
    overflow-wrap: anywhere;
  }
  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .check {
    display: flex;
    gap: 10px;
    align-items: center;
    font-weight: 600;
  }
  .check input {
    width: 20px;
    height: 20px;
    margin: 0;
  }
  .save-bar {
    position: sticky;
    bottom: 0;
    z-index: 5;
    display: flex;
    justify-content: flex-end;
    padding: 12px 0;
    background: var(--color-bg);
    border-top: 1px solid var(--color-line);
  }
  @media (max-width: 799px) {
    .save-bar {
      bottom: calc(62px + env(safe-area-inset-bottom, 0px));
    }
    .save-bar .a-btn {
      width: 100%;
      min-height: 50px;
    }
  }
</style>
