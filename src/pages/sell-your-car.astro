---
// Sell your car (the old site's URL, kept). Layout A of the sell page mockups
// (claude.ai/artifact/74q48axCbeYVZZ1URB8Dm6): the registration first, then
// "where should we send your price?". Layout B is at /sell-your-car/b.
//
// One form in two steps. Step 1 is the registration: the DVLA and MOT records
// find the car (/api/lookup, as on the landing pages). Step 2 is the car and
// where to reply: a car that was found shows as one line; otherwise (foreign
// plates, not registered, not found, no lookup) its make, model and so on are
// asked for. Without JavaScript both steps show, one under the other.
//
// The form posts to this page, which saves the request and redirects to the
// thank-you message (so a refresh can't send it twice). Words come from the
// brand (copy.sell); the fields and checks are shared with layout B.
import "../styles/sell-form.css";
import Base from "../layouts/Base.astro";
import WhatsAppLine from "../components/WhatsAppLine.astro";
import CarFields from "../components/sell/CarFields.astro";
import ContactFields from "../components/sell/ContactFields.astro";
import Hidden from "../components/sell/Hidden.astro";
import Message from "../components/sell/Message.astro";
import Photos from "../components/sell/Photos.astro";
import Problems from "../components/sell/Problems.astro";
import Thanks from "../components/sell/Thanks.astro";
import { brand } from "../brands/index.ts";
import { lookupReady } from "../lib/vehicle-lookup.ts";
import { MAX_PHOTOS, MAX_PHOTO_BYTES } from "../lib/leads.ts";
import { rememberName, rememberedName } from "../lib/first-name.ts";
import { emptySellForm, receiveSellForm } from "../lib/sell-form.ts";

const copy = brand.copy.sell;
if (!brand.features.sellForm || !copy) return new Response(null, { status: 404 });

let state = emptySellForm();
// Something was sent and came back: go straight to step 2.
let step = "reg";
if (Astro.request.method === "POST") {
  const result = await receiveSellForm(Astro.request);
  if ("sender" in result) {
    rememberName(Astro.cookies, result.sender, "/sell-your-car");
    return Astro.redirect("/sell-your-car?sent=1", 303);
  }
  state = result;
  step = "details";
  Astro.response.status = 400;
}
const sent = Astro.url.searchParams.get("sent") === "1";
// The thank-you has the sender's name in it.
if (sent) Astro.response.headers.set("Cache-Control", "no-store");
const lookup = lookupReady();
const privacy = brand.legal?.find((l) => l.label === "Privacy")?.href;
---

<Base title="Sell your car" description={`Sell your left hand drive car. ${copy.bandText}`} flush>
  <main class="page" data-at={sent ? "sent" : step}>
    {sent ? (
      <div class="col"><Thanks name={rememberedName(Astro.cookies)} /></div>
    ) : (
      <form class="col sell-form" method="post" enctype="multipart/form-data" novalidate data-lookup={lookup ? "on" : undefined} data-max-photos={MAX_PHOTOS} data-max-bytes={MAX_PHOTO_BYTES}>
        <Hidden state={state} />

        <div data-step="reg">
          <h1 tabindex="-1">Sell your car</h1>
          <p class="sub">{lookup ? copy.introLookup : copy.intro}</p>
          <label class="lbl" for="reg">Registration</label>
          <div class="plate-row">
            <input id="reg" name="reg" class="plate" value={state.values.reg} placeholder="AB12 CDE" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="40" aria-describedby="reg-err" />
            <button class="go find js-only" type="button" data-act="find">{lookup ? "Find my car" : "Continue"}</button>
          </div>
          <p class="err" id="reg-err" role="alert" hidden></p>
          <button class="link js-only" type="button" data-act="manual">Registered outside the UK, or not registered?</button>
          <div class="wa-row js-only"><WhatsAppLine /></div>
        </div>

        <div class="details" data-step="details">
          <Problems state={state} />

          <section class="block" data-car-fields>
            <button class="link back js-only" type="button" data-act="back">Back</button>
            <h2 tabindex="-1">Tell us about your car</h2>
            <p class="note" data-out="note" hidden></p>
            <CarFields state={state} reg2 mileage />
          </section>

          <section class="block">
            <h2 tabindex="-1" data-contact-head>Where should we send your price?</h2>
            <div class="found" data-found hidden>
              <span class="mini-plate" data-out="reg"></span>
              <span class="found-car"><strong data-out="title"></strong><span data-out="facts"></span></span>
              <button class="link" type="button" data-act="back">Change</button>
            </div>
            <ContactFields state={state} />
            <div class="extras">
              <details class="extra" open={state.errors.photos ? true : undefined}>
                <summary>+ Add photos</summary>
                <Photos state={state} />
              </details>
              <details class="extra" open={state.values.message ? true : undefined}>
                <summary>+ Add a message</summary>
                <Message state={state} />
              </details>
            </div>
            <button class="go send" type="submit">Get my free valuation</button>
            <p class="small">{copy.trust}{privacy && <> · <a href={privacy}>Privacy policy</a></>}</p>
            <div class="wa-row"><WhatsAppLine /></div>
          </section>
        </div>
      </form>
    )}

    <section class="steps-strip" aria-labelledby="next-h">
      <div class="wrap">
        <h2 class="sr" id="next-h">What happens next</h2>
        <ol class="steps">
          {copy.steps.map((s, i) => (
            <li>
              <strong><span class="n" aria-hidden="true">{i + 1}</span> {s.title}</strong>
              <span class="muted">{s.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>
</Base>

<script>
  // Moves between the two steps. The form itself is a normal POST; the lookup
  // and the checks are in scripts/sell-form.ts.
  import { sellForm } from "../scripts/sell-form.ts";

  const form = document.querySelector<HTMLFormElement>(".page .sell-form");
  if (form) {
    const page = document.querySelector<HTMLElement>(".page")!;
    const { $, field, out, place, tidy, say, note, lookUp, fill, forget, facts, why, check, toFirstProblem, sending, canLookUp } = sellForm(form);
    const plate = field("reg");
    const reg2 = field("reg2");
    const findBtn = $<HTMLButtonElement>('[data-act="find"]');
    const carFields = $("[data-car-fields]");
    const found = $("[data-found]");
    const mileage = $("[data-mileage]");

    // Step 2 gets its own history entry, so the phone's Back goes to step 1.
    const show = (step: "reg" | "details") => {
      page.dataset.at = step;
      window.scrollTo({ top: 0, behavior: "instant" });
      const head = step === "reg" ? "h1" : found.hidden ? "[data-car-fields] h2" : "[data-contact-head]";
      $(head).focus({ preventScroll: true });
    };
    const toDetails = () => {
      if (history.state?.sellStep !== "details") history.pushState({ sellStep: "details" }, "");
      show("details");
    };
    const toReg = () => {
      if (history.state?.sellStep === "details") history.back();
      else show("reg");
    };
    window.addEventListener("popstate", (e) => show(e.state?.sellStep === "details" ? "details" : "reg"));

    // The car was found: one line for it, and its fields filled out of sight.
    // Asked for: the fields show.
    const layOut = (isFound: boolean) => {
      found.hidden = !isFound;
      carFields.hidden = isFound;
      $(isFound ? "[data-contact]" : "[data-car-fields] .two").append(mileage);
    };
    const syncPlace = () => ($("[data-reg2]").hidden = place("Not registered").checked);
    const toManual = (where: string, text = "") => {
      note(text);
      place(where).checked = true;
      reg2.value = tidy(plate.value);
      syncPlace();
      layOut(false);
      toDetails();
    };

    let asked = 0;
    const find = async () => {
      const reg = tidy(plate.value);
      if (!reg) {
        say("reg", "Enter your registration, or choose the link below.");
        return plate.focus();
      }
      plate.value = reg;
      say("reg");
      forget();
      if (!canLookUp) return toManual("UK");
      const mine = ++asked;
      findBtn.disabled = true;
      findBtn.textContent = "Finding your car…";
      const r = await lookUp(reg);
      findBtn.disabled = false;
      findBtn.textContent = "Find my car";
      // They've moved on, or typed another registration, while it was looking.
      if (mine !== asked || page.dataset.at !== "reg" || tidy(plate.value) !== reg) return;
      if (r.kind === "found") {
        fill(r.vehicle, r.summary);
        // The DVLA doesn't hold models, and the MOT records don't always.
        if (!r.vehicle.make || !r.vehicle.model) return toManual("UK", why(reg, r));
        out("reg").textContent = reg;
        out("title").textContent = `${r.vehicle.make} ${r.vehicle.model}`;
        out("facts").textContent = facts(r.vehicle);
        layOut(true);
        return toDetails();
      }
      toManual(r.kind === "unknown" ? "Europe" : "UK", why(reg, r));
    };

    form.addEventListener("click", (e) => {
      const act = (e.target as HTMLElement).closest<HTMLElement>("[data-act]")?.dataset.act;
      if (act === "find") find();
      else if (act === "back") toReg();
      else if (act === "manual") {
        asked++;
        say("reg");
        forget();
        toManual("Europe");
      }
    });
    plate.addEventListener("input", () => say("reg"));
    reg2.addEventListener("input", () => (plate.value = reg2.value));
    form.querySelectorAll('input[name="registered"]').forEach((r) => r.addEventListener("change", syncPlace));

    form.addEventListener("submit", (e) => {
      // Enter in the registration box looks it up.
      if (page.dataset.at === "reg") {
        e.preventDefault();
        if (!findBtn.disabled) find();
      } else if (check()) sending();
      else e.preventDefault();
    });

    // The server sent the form back: its registration shows in step 2's box too.
    if (page.dataset.at === "details") {
      reg2.value = plate.value;
      syncPlace();
      toFirstProblem();
    }
  }
</script>

<style>
  .page {
    background: var(--color-surface);
  }
  .col {
    width: min(600px, 100% - 32px);
    margin-inline: auto;
    padding-block: 72px;
  }
  /* With scripts, one step at a time; without, both, one under the other. */
  :global(html.js) .page[data-at="reg"] [data-step="details"],
  :global(html.js) .page[data-at="details"] [data-step="reg"],
  :global(html.js) .page[data-at="details"] .steps-strip {
    display: none;
  }
  :global(html:not(.js)) .details {
    margin-top: 40px;
  }
  .page[data-at="details"] .col {
    padding-block: 48px 64px;
  }

  h1,
  .col h2 {
    font: 700 clamp(34px, 5vw, 44px)/1.05 var(--font-display);
    margin: 0;
    outline: none;
  }
  .col h2 {
    font-size: clamp(28px, 3.4vw, 36px);
    line-height: 1.05;
  }
  .sub {
    margin: 12px 0 32px;
    font-size: clamp(17px, 1.6vw, 19px);
    color: var(--color-muted);
  }
  .plate-row {
    display: flex;
    gap: 10px;
  }
  .plate-row .plate {
    flex: 1;
  }
  .find {
    flex: none;
    width: 190px;
  }
  [data-step="reg"] .link {
    margin-top: 8px;
  }
  .back {
    justify-self: start;
    margin-bottom: -12px;
  }
  .wa-row {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--color-line);
  }

  .details,
  .block {
    display: grid;
    gap: 22px;
  }
  .details {
    gap: 40px;
  }
  /* Lets long words wrap instead of stretching the column. */
  .details > :global(*),
  .block > :global(*) {
    min-width: 0;
  }

  /* Add photos and Add a message: side by side until opened, then full width. */
  .extras {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    margin-block: -10px;
  }
  .extra[open] {
    flex: 1 1 100%;
    min-width: 0;
    padding-block: 10px;
  }
  .block .small {
    margin-top: -10px;
  }
  .block .wa-row {
    margin-top: -6px;
  }

  .steps-strip {
    padding-block: 34px 40px;
    background: var(--color-bg);
    border-top: 1px solid var(--color-line);
  }
  .steps-strip .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }
  .steps li > * {
    display: block;
  }
  .steps strong {
    font: 700 22px/1.2 var(--font-display);
  }
  .steps .n {
    color: var(--color-accent);
  }
  .muted {
    color: var(--color-muted);
  }

  @media (max-width: 767px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    /* Clear of the floating WhatsApp button. */
    .steps li {
      padding-right: 72px;
    }
  }
  @media (max-width: 560px) {
    .col,
    .page[data-at="details"] .col {
      padding-block: 28px 24px;
    }
    .sub {
      margin: 10px 0 24px;
    }
    .plate-row {
      flex-direction: column;
    }
    .plate-row .plate {
      flex: none;
    }
    .find {
      width: 100%;
      min-height: 56px;
    }
  }
</style>
