---
// Admin: every car, drafts included, with tabs by status and a search.
// From the admin mockups (a table on computers, cards on phones).
import Admin from "../../../layouts/Admin.astro";
import { hasDb } from "../../../lib/db.ts";
import { adminCars, priceLabel, STATUS_LABEL, type CarStatus } from "../../../lib/cars.ts";
import { listLeads } from "../../../lib/leads.ts";
import { pick } from "../../../lib/photos.ts";
import { startPhotoWork } from "../../../lib/photo-queue.ts";

const ready = hasDb();
const all = ready ? await adminCars() : [];
if (ready && all.some((c) => c.pending?.length)) startPhotoWork();

const TABS: ["all" | CarStatus, string][] = [
  ["all", "All"], ["available", "For sale"], ["reserved", "Reserved"], ["sold", "Sold"], ["draft", "Drafts"],
];
const tab = (TABS.find(([id]) => id === Astro.url.searchParams.get("status"))?.[0] ?? "all") as "all" | CarStatus;
const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 80);
const count = (id: string) => (id === "all" ? all.length : all.filter((c) => c.status === id).length);

const shown = all
  .filter((c) => tab === "all" || c.status === tab)
  .filter((c) => !q || `${c.make} ${c.model} ${c.year ?? ""}`.toLowerCase().includes(q.toLowerCase()));

const [sell, enquiries] = await Promise.all([listLeads("sell"), listLeads("enquiries")]);
const fresh = (l: { admin: { stage: string } }[]) => l.filter((x) => x.admin.stage === "New").length;
const href = (status: string) => {
  const u = new URLSearchParams();
  if (status !== "all") u.set("status", status);
  if (q) u.set("q", q);
  return `/admin/cars${u.size ? `?${u}` : ""}`;
};
const saved = Astro.url.searchParams.get("deleted") === "1";
---

<Admin title="Cars" active="cars">
  <div class="page">
    <div class="head">
      <h1 class="admin-h1">Cars</h1>
      {ready && (
        <a class="a-btn pri" href="/admin/cars/new">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          Add a car
        </a>
      )}
    </div>

    {!ready ? (
      <p class="a-note">The database isn't set up yet: add <code>MONGODB_URI</code> to <code>.env</code> (see the README), then restart the site.</p>
    ) : (
      <>
        {saved && <p class="a-note" role="status">The car was deleted.</p>}
        <div class="stats">
          <a href={href("available")}><b>{count("available")}</b> for sale</a>
          <a href="/admin/leads?kind=sell"><b>{fresh(sell)}</b> new sell {fresh(sell) === 1 ? "request" : "requests"}</a>
          <a href="/admin/leads?kind=enquiries"><b>{fresh(enquiries)}</b> new {fresh(enquiries) === 1 ? "enquiry" : "enquiries"}</a>
          <a href={href("draft")}><b>{count("draft")}</b> {count("draft") === 1 ? "draft" : "drafts"}, not on the site</a>
        </div>

        <div class="bar">
          <nav class="tabs" aria-label="Show">
            {TABS.map(([id, label]) => (
              <a href={href(id)} aria-current={id === tab ? "page" : undefined}>{label} <small>{count(id)}</small></a>
            ))}
          </nav>
          <form class="search" method="get" role="search">
            {tab !== "all" && <input type="hidden" name="status" value={tab} />}
            <label class="a-lbl" for="q">Search</label>
            <div class="row">
              <input class="a-in" id="q" name="q" type="search" value={q} placeholder="Make, model or year" />
              <button class="a-btn" type="submit">Find</button>
            </div>
          </form>
        </div>

        {shown.length ? (
          <ul class="list">
            {shown.map((c) => {
              const cover = c.photos[0];
              const thumb = cover ? pick(cover.avif, 300).url : undefined;
              return (
                <li>
                  <a class="car" href={`/admin/cars/${c.id}`}>
                    {thumb ? <img src={thumb} alt="" width="120" height="68" loading="lazy" /> : <span class="nophoto">No photos</span>}
                    <span class="name">
                      <strong>{c.make} {c.model}</strong>
                      <span class="muted">{[c.year, c.mileage].filter(Boolean).join(" · ") || "No details yet"}</span>
                    </span>
                    <span class="price">{priceLabel(c)}</span>
                    <span class="muted photos">
                      {c.photos.length} {c.photos.length === 1 ? "photo" : "photos"}
                      {c.pending?.length ? `, ${c.pending.length} on the way` : ""}
                    </span>
                    <span class="st"><span class={`a-chip ${c.status}`}>{STATUS_LABEL[c.status]}</span></span>
                    <span class="muted when">{c.updatedAt ? new Date(c.updatedAt).toLocaleDateString("en-GB", { day: "numeric", month: "short" }) : ""}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="empty">{q ? `No cars match “${q}”.` : "No cars here."}</p>
        )}
      </>
    )}
  </div>
</Admin>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 1200px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
  }
  .stats a {
    display: block;
    padding: 14px 18px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    color: var(--color-muted);
    text-decoration: none;
  }
  .stats b {
    display: block;
    font: 700 32px/1 var(--font-display);
    color: var(--color-fg);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 24px;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    border-bottom: 1px solid var(--color-line);
  }
  .tabs a {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 12px;
    border-bottom: 3px solid transparent;
    color: var(--color-muted);
    font-weight: 600;
    text-decoration: none;
  }
  .tabs a[aria-current="page"] {
    color: var(--color-fg);
    border-bottom-color: var(--color-accent);
  }
  .tabs small {
    font-weight: 400;
  }
  .search .row {
    display: flex;
    gap: 8px;
  }
  .search .a-in {
    min-width: 0;
    width: 240px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  .list li + li {
    border-top: 1px solid var(--color-line);
  }
  .car {
    display: grid;
    grid-template-columns: 120px minmax(0, 2fr) 100px 150px 100px 70px;
    align-items: center;
    gap: 16px;
    padding: 10px 14px;
    color: var(--color-fg);
    text-decoration: none;
  }
  .car:hover {
    background: var(--color-bg);
  }
  .car img,
  .nophoto {
    width: 120px;
    height: 68px;
    object-fit: cover;
    background: var(--color-line);
  }
  .nophoto {
    display: grid;
    place-items: center;
    font-size: 12px;
    color: var(--color-muted);
  }
  .name {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .name strong {
    overflow-wrap: anywhere;
  }
  .price {
    font-weight: 700;
  }
  .muted {
    color: var(--color-muted);
    font-size: 14px;
  }
  .empty {
    margin: 0;
    padding: 28px;
    text-align: center;
    color: var(--color-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  /* Phones and narrow windows: each car a card. */
  @media (max-width: 1000px) {
    .car {
      grid-template-columns: 104px minmax(0, 1fr);
      grid-template-areas: "img name" "img price" "img chip";
      row-gap: 2px;
      column-gap: 12px;
    }
    .car img,
    .nophoto {
      grid-area: img;
      width: 104px;
      height: 70px;
    }
    .name {
      grid-area: name;
    }
    .price {
      grid-area: price;
      font-size: 14px;
    }
    .st {
      grid-area: chip;
    }
    .photos,
    .when {
      display: none;
    }
    .search,
    .search .a-in {
      width: 100%;
    }
    .search .row .a-in {
      flex: 1;
    }
  }
</style>
