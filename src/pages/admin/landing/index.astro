---
// Admin: landing pages ("Sell your Porsche 911"), drafts included.
import Admin from "../../../layouts/Admin.astro";
import { hasDb } from "../../../lib/db.ts";
import { listLandings, landingName } from "../../../lib/landings.ts";

const ready = hasDb();
const pages = ready ? await listLandings() : [];
const deleted = Astro.url.searchParams.get("deleted") === "1";
---

<Admin title="Landing pages" active="landing">
  <div class="page">
    <div class="head">
      <div>
        <h1 class="admin-h1">Landing pages</h1>
        <p class="a-hint">A "Sell your…" page for each make and model you want to be found for, such as /sell-your-porsche-911.</p>
      </div>
      {ready && (
        <a class="a-btn pri" href="/admin/landing/new">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          Add a page
        </a>
      )}
    </div>
    {!ready && <p class="a-note">The database isn't set up yet: add <code>MONGODB_URI</code> to <code>.env</code>, then restart the site.</p>}
    {deleted && <p class="a-note" role="status">The page was deleted.</p>}

    {ready && (pages.length ? (
      <ul class="list">
        {pages.map((l) => (
          <li>
            <a class="row" href={`/admin/landing/${l.id}`}>
              <span class="name">
                <strong>Sell your {landingName(l)}</strong>
                <span class="muted">/{l.slug}</span>
              </span>
              <span><span class={`a-chip ${l.status === "published" ? "available" : "draft"}`}>{l.status === "published" ? "Published" : "Draft"}</span></span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">No landing pages yet. Add the first, for example Porsche 911.</p>
    ))}
  </div>
</Admin>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 1000px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }
  .head .a-hint {
    margin: 4px 0 0;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  .list li + li {
    border-top: 1px solid var(--color-line);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 18px;
    color: inherit;
    text-decoration: none;
  }
  .row:hover {
    background: var(--color-bg);
  }
  .name {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .muted {
    color: var(--color-muted);
    font-size: 14px;
  }
  .empty {
    color: var(--color-muted);
  }
</style>
