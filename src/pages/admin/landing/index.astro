---
// Admin: landing pages ("Sell your Porsche 911"), drafts included.
import Admin from "../../../layouts/Admin.astro";
import { hasDb } from "../../../lib/db.ts";
import { listLandings, landingName, landingPhoto } from "../../../lib/landings.ts";
import { listCars } from "../../../lib/cars.ts";
import { pick } from "../../../lib/photos.ts";

const ready = hasDb();
const pages = ready ? await listLandings() : [];
const cars = pages.length ? await listCars() : [];
const deleted = Astro.url.searchParams.get("deleted") === "1";
---

<Admin title="Landing pages" active="landing">
  <div class="page">
    <div class="head">
      <div>
        <h1 class="admin-h1">Landing pages</h1>
        <p class="a-hint">A "Sell your…" page for each make and model you want to be found for, such as /sell-your-porsche-911.</p>
      </div>
      {ready && (
        <a class="a-btn pri" href="/admin/landing/new">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          Add a page
        </a>
      )}
    </div>
    {!ready && <p class="a-note">The database isn't set up yet: add <code>MONGODB_URI</code> to <code>.env</code>, then restart the site.</p>}
    {deleted && <p class="a-note" role="status">The page was deleted.</p>}

    {ready && (pages.length ? (
      <ul class="list">
        {pages.map((l) => {
          const hero = landingPhoto(l, cars);
          return (
          <li>
            <a class="row" href={`/admin/landing/${l.id}`}>
              {hero ? (
                <span class="pic">
                  <img src={pick(hero.photo.avif, 300).url} alt="" width="120" height="68" loading="lazy" />
                  {hero.fromStock && <span class="stock">From stock</span>}
                </span>
              ) : <span class="nophoto">No photo</span>}
              <span class="name">
                <strong>Sell your {landingName(l)}</strong>
                <span class="muted">/{l.slug}</span>
              </span>
              <span><span class={`a-chip ${l.status === "published" ? "available" : "draft"}`}>{l.status === "published" ? "Published" : "Draft"}</span></span>
            </a>
          </li>
          );
        })}
      </ul>
    ) : (
      <p class="empty">No landing pages yet. Add the first, for example Porsche 911.</p>
    ))}
  </div>
</Admin>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 1000px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }
  .head .a-hint {
    margin: 4px 0 0;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  .list li + li {
    border-top: 1px solid var(--color-line);
  }
  /* As the blog's list: photo, name, status. */
  .row {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 10px 14px;
    color: inherit;
    text-decoration: none;
  }
  .row:hover {
    background: var(--color-bg);
  }
  .pic {
    position: relative;
    display: block;
  }
  .pic img,
  .nophoto {
    display: block;
    width: 120px;
    height: 68px;
    object-fit: cover;
    background: var(--color-line);
  }
  .nophoto {
    display: grid;
    place-items: center;
    font-size: 12px;
    color: var(--color-muted);
  }
  /* The page has no photo of its own, so it borrows a car's. */
  .stock {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 1px 6px;
    font-size: 11px;
    color: #fff;
    background: rgb(0 0 0 / 0.7);
  }
  .name {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  @media (max-width: 639px) {
    .row {
      grid-template-columns: 96px minmax(0, 1fr);
    }
    .pic,
    .nophoto {
      grid-row: span 2;
    }
    .pic img,
    .nophoto {
      width: 96px;
      height: 54px;
    }
  }
  .muted {
    color: var(--color-muted);
    font-size: 14px;
  }
  .empty {
    color: var(--color-muted);
  }
</style>
