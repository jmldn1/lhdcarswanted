---
// A blog post, from the blog/about/contact mockups: one readable column,
// the cover photo, the post, a "Got a car to sell?" box, share links and
// more posts (same category first).
import Base from "../../layouts/Base.astro";
import CarPhoto from "../../components/CarPhoto.astro";
import SellBand from "../../components/SellBand.astro";
import { brand } from "../../brands/index.ts";
import { getPost, listPosts, renderBody, readMinutes, postDate } from "../../lib/blog.ts";
import { makeSlug } from "../../lib/cars.ts";

if (!brand.features.blog) return new Response(null, { status: 404 });
const post = await getPost(Astro.params.slug ?? "");
if (!post) return new Response(null, { status: 404 });

const others = (await listPosts()).filter((p) => p.id !== post.id);
const more = [...others.filter((p) => p.category === post.category), ...others.filter((p) => p.category !== post.category)].slice(0, 3);
const url = new URL(`/blog/${post.slug}`, Astro.url).href;
const sell = brand.features.sellForm ? brand.copy.sell : undefined;
---

<Base title={post.title} description={post.intro || post.title} flush>
  <main class="page">
    <header class="wrap">
      <div class="col head">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/blog">Blog</a>
          {post.category && (<><span aria-hidden="true">/</span><a href={`/blog?category=${makeSlug(post.category)}`}>{post.category}</a></>)}
        </nav>
        <h1>{post.title}</h1>
        {post.intro && <p class="standfirst">{post.intro}</p>}
        <p class="meta">
          {[post.author && `By ${post.author}`, postDate(post.date), `${readMinutes(post.body)} min read`].filter(Boolean).join(" · ")}
        </p>
      </div>
    </header>

    {post.cover && (
      <div class="wrap">
        <div class="cover">
          <CarPhoto photo={post.cover} fit="cover" priority sizes="(min-width: 1148px) 1100px, calc(100vw - 32px)" alt="" />
        </div>
      </div>
    )}

    <div class="wrap">
      <article class="col prose" set:html={renderBody(post.body)} />

      <div class="col after">
        {sell && (
          <aside class="cta">
            <div>
              <strong>Got a car to sell?</strong>
              <p>Get a free valuation today.</p>
            </div>
            <a class="btn btn-primary b" href="/sell-your-car">Get my free valuation</a>
          </aside>
        )}

        <div class="share">
          <span>Share this post</span>
          <div class="share-btns">
            <button class="copy" type="button" data-url={url}>Copy link</button>
            <a href={`https://wa.me/?text=${encodeURIComponent(`${post.title} ${url}`)}`} target="_blank" rel="noopener">WhatsApp</a>
            <a href={`mailto:?subject=${encodeURIComponent(post.title)}&body=${encodeURIComponent(url)}`}>Email</a>
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener">Facebook</a>
          </div>
        </div>
      </div>
    </div>

    {more.length > 0 && (
      <section class="wrap" aria-labelledby="more-h">
        <h2 id="more-h" class="more-h">More from the blog</h2>
        <ul class="grid">
          {more.map((p) => (
            <li>
              <a class="card" href={`/blog/${p.slug}`}>
                <div class="card-pic">
                  {p.cover && <CarPhoto photo={p.cover} fit="cover" sizes="(min-width: 1240px) 380px, (min-width: 900px) 30vw, (min-width: 600px) 45vw, calc(100vw - 32px)" alt="" />}
                </div>
                <div class="card-text">
                  {p.category && <span class="eyebrow">{p.category}</span>}
                  <h3>{p.title}</h3>
                  <span class="meta">{readMinutes(p.body)} min read</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
  <SellBand />
</Base>

<script>
  // Copy link: the phone's share sheet where there is one, else the clipboard.
  document.querySelector<HTMLButtonElement>(".copy")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const url = btn.dataset.url ?? location.href;
    try {
      await navigator.clipboard.writeText(url);
      btn.textContent = "Link copied";
    } catch {
      btn.textContent = url;
    }
  });
</script>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: 40px 72px;
  }
  /* Full width: in a flex column, .wrap's auto margins would shrink it. */
  .page > .wrap {
    width: 100%;
  }
  .col {
    max-width: 720px;
    margin-inline: auto;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 15px;
    color: var(--color-muted);
  }
  .crumbs a {
    color: var(--color-muted);
  }
  h1 {
    font: 700 clamp(38px, 5.5vw, 56px)/1.03 var(--font-display);
    margin: 0;
    overflow-wrap: anywhere;
  }
  .standfirst {
    margin: 0;
    font-size: 21px;
  }
  .meta {
    margin: 0;
    font-size: 15px;
    color: var(--color-muted);
  }
  .cover {
    max-width: 1100px;
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    background: var(--color-line);
  }
  .prose {
    font-size: 19px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 22px;
  }
  /* Tailwind's reset takes list markers off; posts want them back. */
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 24px;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
  .prose :global(h2) {
    font: 700 34px/1.1 var(--font-display);
    margin: 40px 0 14px;
  }
  .prose :global(h3) {
    font: 700 26px/1.15 var(--font-display);
    margin: 32px 0 10px;
  }
  .prose :global(blockquote) {
    margin: 0 0 28px;
    padding: 6px 0 6px 24px;
    border-left: 4px solid var(--color-accent);
    font: 600 26px/1.3 var(--font-display);
  }
  .prose :global(blockquote p) {
    margin: 0;
  }
  @media (max-width: 639px) {
    .prose {
      font-size: 18px;
    }
    .prose :global(h2) {
      font-size: 30px;
    }
  }
  .after {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 12px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 26px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  .cta strong {
    font: 700 26px/1.1 var(--font-display);
  }
  .cta p {
    margin: 4px 0 0;
  }
  .b {
    min-height: 50px;
    font-weight: 700;
  }
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
  }
  .share-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .share-btns a,
  .copy {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-fg);
    font: 600 14px/1 var(--font-body);
    text-decoration: none;
    cursor: pointer;
  }
  .more-h {
    font: 700 32px/1.1 var(--font-display);
    margin: 24px 0 20px;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 24px;
  }
  @media (min-width: 600px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    color: var(--color-fg);
    text-decoration: none;
  }
  .card-pic {
    aspect-ratio: 16 / 9;
    background: var(--color-line);
  }
  .card-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px 20px;
  }
  .card h3 {
    font: 700 24px/1.1 var(--font-display);
    margin: 0;
  }
</style>
