---
// A car's page, from mockup A ("Showroom", after London LHD Centre v1):
// photos with thumbnails under them, and beside them a card with the price,
// the ways to get in touch and the key facts, which stays in view while the
// page scrolls. Then the description, a "talk to us" band and other cars.
// Photos are shown whole in a native swipe strip; full-screen viewing is
// lightGallery (its free GPLv3 build for now, see BRIEF.md). Enquire opens
// an email until the enquiry form is built.
import Base from "../../layouts/Base.astro";
import CarPhoto from "../../components/CarPhoto.astro";
import CarCard from "../../components/CarCard.astro";
import CarDescription from "../../components/CarDescription.astro";
import { brand } from "../../brands/index.ts";
import { getCar, listCars, specsLine, priceLabel, makeSlug, carFacts } from "../../lib/cars.ts";
import { lightboxJson } from "../../lib/lightbox.ts";
import { pageVideo } from "../../lib/video.ts";

const car = await getCar(Astro.params.slug ?? "");
if (!car) return new Response(null, { status: 404 });
// The walkaround video, if the car has one: first in the thumbnails, and a
// button in the card. Only its poster (one of the car's photos) loads with the page.
const video = pageVideo(car);

// The facts the car's record has.
const facts = carFacts(car);
// Two other cars for sale, then a tile linking to them all.
const others = (await listCars()).filter((c) => c.id !== car.id && c.status !== "sold").slice(0, 2);
const whatsapp = brand.contact.whatsapp;

const first = car.photos[0];
// Phones and upright tablets: the strip takes the shape of the first photo
// (most of a car's photos share it); any photo of another shape is shown whole
// inside that frame. From 960px it's 16:9 for every car, as on v1, so the photo
// and its thumbnails fit a laptop screen: photos fill it, trimmed equally top
// and bottom, except upright or square ones, which would lose too much.
const ratio = first ? `${first.width} / ${first.height}` : "3 / 2";
const isTall = (p: { width: number; height: number }) => p.width / p.height < 1.2;
const sales = brand.contact.phones[0];

const name = `${car.make} ${car.model}`;
const enquire = `mailto:${brand.contact.email}?subject=${encodeURIComponent(`${name} (${Astro.url.pathname})`)}`;
const whatsappHref = whatsapp && `https://wa.me/${whatsapp}?text=${encodeURIComponent(`${name}: ${Astro.url.href}`)}`;
---

<Base title={`${car.make} ${car.model}`} description={specsLine(car)}>
 <div class="car-page">
  <main class="wrap page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/cars">All cars</a><span aria-hidden="true">/</span><a href={`/cars?make=${makeSlug(car.make)}`}>{car.make}</a>
    </nav>

    <div class="layout">
      <section class="gallery" aria-label="Photos">
        <div class="frame" style={`--first-photo:${ratio}`}>
          <div class="strip" tabindex="0">
            {car.photos.map((p, i) => (
              <figure class:list={["slide", { tall: isTall(p) }]} id={`photo-${i + 1}`}>
                <CarPhoto
                  photo={p}
                  fit="contain"
                  priority={i === 0}
                  alt={p.alt ?? `${car.make} ${car.model}, photo ${i + 1} of ${car.photos.length}`}
                  sizes="(min-width: 1240px) 780px, (min-width: 960px) 62vw, calc(100vw - 32px)"
                  style={i === 0 ? `view-transition-name: car-${car.id}` : undefined}
                />
              </figure>
            ))}
          </div>
          {car.photos.length > 1 && (
            <>
              <div class="arrows">
                <button class="prev" type="button" aria-label="Previous photo">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                </button>
                <button class="next" type="button" aria-label="Next photo">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                </button>
              </div>
              <button class="view-all" type="button" aria-label={`View all ${car.photos.length} photos`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" /></svg>
                <span aria-hidden="true"><span class="wide">View all </span>{car.photos.length}</span>
              </button>
              <span class="counter" aria-hidden="true"><span class="n">1</span> / {car.photos.length}</span>
            </>
          )}
        </div>
        {(car.photos.length > 1 || video) && (
          <div class="thumbs">
            {video && (
              <button type="button" class="thumb vthumb" data-video aria-label={video.label}>
                {video.poster && <CarPhoto photo={video.poster} fit="cover" sizes="(min-width: 960px) 180px, 27vw" />}
                <span class="vmark" aria-hidden="true">
                  <span class="vplay"><svg viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z" /></svg></span>
                  Video{video.length && ` ${video.length}`}
                </span>
              </button>
            )}
            {car.photos.map((p, i) => (
              <button type="button" class="thumb" data-i={i} aria-label={`Show photo ${i + 1}`} aria-current={i === 0 ? "true" : undefined}>
                <CarPhoto photo={p} fit="cover" sizes="(min-width: 960px) 180px, 27vw" />
              </button>
            ))}
          </div>
        )}
        <script type="application/json" id="lightbox-photos" set:html={lightboxJson(car)} />
        {video && <script type="application/json" id="car-video" set:html={video.json} />}
      </section>

      <aside class="card" aria-label="Price and details">
        {car.status !== "available" && <span class="status">{car.status === "sold" ? "Sold" : "Reserved"}</span>}
        <div class="eyebrow">{car.make}</div>
        <h1>{car.model}</h1>
        <p class="specs">{specsLine(car)}</p>
        <p class="price">
          <span class="amount">{priceLabel(car)}</span>
          {!car.price && <span class="poa">Price on application</span>}
        </p>
        {sales && (
          <a class="btn btn-primary big" href={`tel:${sales.tel}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
            Call {sales.display}
          </a>
        )}
        <div class={whatsappHref ? "pair" : undefined}>
          {whatsappHref && (
            <a class="btn big" href={whatsappHref}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21l1.6-4.7A8.5 8.5 0 1 1 8 19.6z" /></svg>
              WhatsApp
            </a>
          )}
          <a class="btn btn-dark big" href={enquire}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4z" /><path d="m4 7 8 6 8-6" /></svg>
            Enquire
          </a>
        </div>
        {video && (
          <button class="btn big watch" type="button" data-video>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path class="fill" d="M7 4.5v15l13-7.5z" /></svg>
            Watch the walkaround video{video.length && <span class="len">{video.length}</span>}
          </button>
        )}
        {facts.length > 0 && (
          <dl class="facts">
            {facts.map(([k, v]) => (
              <div><dt>{k}</dt><dd>{v}</dd></div>
            ))}
          </dl>
        )}
        <button class="share" type="button" data-title={name}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M16 6l-4-4-4 4M12 2v13" /></svg>
          <span>Share this car</span>
        </button>
      </aside>

      {car.description && (
        <section class="about" aria-labelledby="about-h">
          <h2 id="about-h">About this car</h2>
          <CarDescription text={car.description} />
        </section>
      )}
    </div>
  </main>

  <section class="talk">
    <div class="wrap talk-in">
      <h2>Talk to us about this {car.model}</h2>
      <div class="talk-btns">
        {sales && <a class="btn btn-light big" href={`tel:${sales.tel}`}>Call {sales.display}</a>}
        <a class="btn btn-primary big" href={enquire}>Send an enquiry</a>
      </div>
    </div>
  </section>

  {others.length > 0 && (
    <section class="wrap more" aria-labelledby="more-h">
      <h2 id="more-h">Other cars you might like</h2>
      <div class="more-grid">
        {others.map((c) => <CarCard car={c} fit={brand.cardPhoto.fit} />)}
        <a class="all-cars" href="/cars">
          <strong>See all our cars</strong>
          <span>Every car we have in stock</span>
          <span class="go">Browse cars</span>
        </a>
      </div>
    </section>
  )}

  <div class="call-bar">
    {sales && <a class="btn big" href={`tel:${sales.tel}`}>Call</a>}
    <a class="btn btn-dark big" href={enquire}>Enquire</a>
  </div>
 </div>
</Base>

<script>
  import { openLightbox } from "../../scripts/lightbox.ts";
  import { wireVideo } from "../../scripts/video.ts";

  wireVideo();

  // Arrows, counter and thumbnails for the native strip (swipe and scroll need no script).
  const strip = document.querySelector<HTMLElement>(".strip");
  const n = document.querySelector(".counter .n");
  const row = document.querySelector<HTMLElement>(".thumbs");
  // The photos' thumbnails (not the video's).
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>(".thumb:not(.vthumb)")];
  if (strip) {
    const go = (i: number) => strip.scrollTo({ left: i * strip.clientWidth, behavior: "smooth" });
    const current = () => Math.round(strip.scrollLeft / strip.clientWidth);
    document.querySelector(".prev")?.addEventListener("click", () => go(current() - 1));
    document.querySelector(".next")?.addEventListener("click", () => go(current() + 1));
    thumbs.forEach((t, i) => t.addEventListener("click", () => go(i)));
    strip.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
        e.preventDefault();
        go(current() + (e.key === "ArrowLeft" ? -1 : 1));
      }
    });
    // The photo showing: its number, its thumbnail marked and kept in view
    // (by scrolling the row only, never the page).
    const show = (i: number) => {
      if (n) n.textContent = String(i + 1);
      thumbs.forEach((t, j) => (j === i ? t.setAttribute("aria-current", "true") : t.removeAttribute("aria-current")));
      const t = thumbs[i];
      if (row && t) {
        const left = t.offsetLeft - row.offsetLeft;
        if (left < row.scrollLeft || left + t.offsetWidth > row.scrollLeft + row.clientWidth) {
          row.scrollTo({ left: left - (row.clientWidth - t.offsetWidth) / 2, behavior: "smooth" });
        }
      }
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (en.isIntersecting) show(Number(en.target.id.replace("photo-", "")) - 1);
        }
      },
      { root: strip, threshold: 0.6 },
    );
    strip.querySelectorAll(".slide").forEach((s) => io.observe(s));

    // Full screen; closing leaves the page on the photo last seen.
    const open = (i: number) =>
      openLightbox(i, (last) => strip.scrollTo({ left: last * strip.clientWidth, behavior: "instant" }));
    strip.querySelectorAll(".slide").forEach((s, i) => s.addEventListener("click", () => open(i)));
    document.querySelector(".view-all")?.addEventListener("click", () => open(current()));
  }

  // Share: the phone's own share sheet where there is one, else copy the link.
  const share = document.querySelector<HTMLButtonElement>(".share");
  share?.addEventListener("click", async () => {
    const url = location.href.split("#")[0];
    if (navigator.share) {
      await navigator.share({ title: share.dataset.title, url }).catch(() => {});
      return;
    }
    const label = share.querySelector("span");
    try {
      await navigator.clipboard.writeText(url);
      if (label) label.textContent = "Link copied";
    } catch {
      if (label) label.textContent = url;
    }
  });
</script>

<style>
  .page {
    padding-top: 20px;
    padding-bottom: 56px;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 15px;
    color: var(--color-muted);
  }
  .crumbs a {
    color: var(--color-muted);
  }
  /* Phones: photos, the card, then the description. From 960px the card
     sits beside the photos and the description, and stays in view. */
  .layout {
    display: grid;
    grid-template-areas: "gallery" "card" "about";
    gap: 28px;
    margin-top: 14px;
  }
  .gallery {
    grid-area: gallery;
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 390px;
      grid-template-rows: auto 1fr;
      grid-template-areas: "gallery card" "about card";
      column-gap: 40px;
      row-gap: 40px;
    }
  }
  .frame {
    position: relative;
    aspect-ratio: var(--first-photo);
    background: var(--color-line);
  }
  @media (min-width: 960px) {
    .frame {
      aspect-ratio: 16 / 9;
    }
    .frame .slide:not(.tall) :global(img) {
      object-fit: cover;
      background-size: cover;
    }
  }
  .strip {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .strip::-webkit-scrollbar {
    display: none;
  }
  .slide {
    flex: 0 0 100%;
    margin: 0;
    cursor: zoom-in;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  /* Small arrows together in the bottom-left corner, the count bottom-right
     (as on v1), so the thumbnails can sit right under the photo. */
  .arrows {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: flex;
    gap: 6px;
  }
  .arrows button {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    color: var(--color-fg);
    box-shadow: 0 1px 4px color-mix(in srgb, var(--color-fg) 25%, transparent);
    cursor: pointer;
  }
  .arrows button:hover {
    background: var(--color-surface);
  }
  .arrows svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* "View all 11" top-right (just "11" with the icon on phones), as on v1. */
  .view-all {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    color: var(--color-fg);
    box-shadow: 0 1px 4px color-mix(in srgb, var(--color-fg) 25%, transparent);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .view-all:hover {
    background: var(--color-surface);
  }
  .view-all svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .view-all .wide {
    display: none;
  }
  @media (min-width: 640px) {
    .view-all .wide {
      display: inline;
    }
  }
  .counter {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 5px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-fg) 70%, transparent);
    color: var(--color-surface);
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  /* 3½ thumbnails across on phones (the half shows there are more), 4 from 640px. */
  .thumbs {
    --across: 3.5;
    --gap: 8px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--across) - 1) * var(--gap)) / var(--across));
    gap: var(--gap);
    margin-top: var(--gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }
  @media (min-width: 640px) {
    .thumbs {
      --across: 4;
      --gap: 10px;
    }
  }
  .thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 0;
    background: var(--color-line);
    cursor: pointer;
  }
  /* The photo showing: an accent outline drawn inside the thumbnail. */
  .thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    outline: 2px solid transparent;
    outline-offset: -2px;
    transition: outline-color 0.15s ease;
  }
  .thumb[aria-current="true"]::after {
    outline-color: var(--color-accent);
  }
  /* The video's thumbnail: its poster, darkened, with a play mark. */
  .vthumb {
    overflow: hidden;
  }
  .vmark {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    background: color-mix(in srgb, var(--color-fg) 50%, transparent);
    color: #fff;
    font: 700 13px/1.1 var(--font-body);
  }
  .vplay {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #fff;
    color: var(--color-fg);
    transition: transform 0.2s ease;
  }
  .vthumb:hover .vplay {
    transform: scale(1.08);
  }
  .vplay svg {
    width: 14px;
    height: 14px;
    margin-left: 2px;
    fill: currentColor;
  }
  .watch .fill {
    fill: currentColor;
    stroke: none;
  }
  .watch .len {
    color: var(--color-muted);
    font-weight: 600;
  }
  .card {
    grid-area: card;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    padding: 28px;
  }
  @media (min-width: 960px) {
    .card {
      position: sticky;
      top: 20px;
    }
  }
  @media (max-width: 639px) {
    .card {
      padding: 22px 18px;
    }
  }
  .status {
    align-self: flex-start;
    padding: 6px 10px;
    background: var(--color-fg);
    color: var(--color-surface);
    font: 700 12px/1 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1 {
    font: 700 clamp(34px, 4vw, 44px)/1.05 var(--font-display);
    margin: -6px 0 0;
    overflow-wrap: anywhere;
  }
  .specs {
    margin: -6px 0 0;
    color: var(--color-muted);
  }
  .price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 4px 0 0;
  }
  .amount {
    font: 700 38px/1 var(--font-display);
  }
  .poa {
    color: var(--color-muted);
    font-size: 15px;
  }
  .big {
    min-height: 50px;
    font-weight: 700;
    border-width: 1.5px;
  }
  .big svg,
  .share svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .card .big,
  .card .pair {
    width: 100%;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .btn-dark {
    background: var(--color-fg);
    border-color: var(--color-fg);
    color: var(--color-surface);
  }
  .btn-light {
    background: var(--color-band-fg);
    border-color: var(--color-band-fg);
    color: var(--color-band);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 20px;
    margin: 4px 0 0;
    border-top: 1px solid var(--color-line);
  }
  .facts div {
    padding: 11px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .facts dt {
    font: 700 12px/1.3 var(--font-body);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .facts dd {
    margin: 2px 0 0;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .share {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    border: 0;
    background: none;
    font: 600 15px/1.3 var(--font-body);
    color: var(--color-accent);
    cursor: pointer;
    overflow-wrap: anywhere;
  }
  .share svg {
    width: 16px;
    height: 16px;
    flex: none;
  }
  .about {
    grid-area: about;
    max-width: 720px;
  }
  .about h2,
  .more h2 {
    font: 700 30px/1.1 var(--font-display);
    margin: 0 0 14px;
  }
  .about {
    font-size: 17px;
  }
  /* "Talk to us": the dark band, as on the homepage's sell band. */
  .talk {
    background: var(--color-band);
    color: var(--color-band-fg);
  }
  .talk-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    padding-block: 40px;
  }
  .talk h2 {
    font: 700 clamp(28px, 3.4vw, 34px)/1.1 var(--font-display);
    margin: 0;
  }
  .talk-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @media (max-width: 639px) {
    .talk-btns,
    .talk-btns .btn {
      width: 100%;
    }
  }
  .more {
    padding-block: 56px 72px;
  }
  .more-grid {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 600px) {
    .more-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .more-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .all-cars {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    padding: 28px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    color: var(--color-muted);
    text-decoration: none;
  }
  .all-cars strong {
    font: 700 26px/1.1 var(--font-display);
    color: var(--color-fg);
  }
  .all-cars .go {
    font-weight: 700;
    color: var(--color-accent);
  }
  /* Phones: Call and Enquire stay at the bottom of the screen until the footer. */
