---
// A car's page, layout B ("Gallery first", from the car page mockups),
// built beside layout A (../[slug].astro) to compare; kept out of search
// engines. A wide mosaic of the first five photos (one photo on phones),
// the title and price, a strip of key facts, the description beside an
// enquiry form, the sell band and more cars.
//
// The enquiry form works without JavaScript: it posts to this page, which
// saves it (LEADS_DIR/enquiries), emails it to the dealer and redirects to a
// thank-you (so a refresh can't send it twice).
import Base from "../../../layouts/Base.astro";
import CarPhoto from "../../../components/CarPhoto.astro";
import CarCard from "../../../components/CarCard.astro";
import Flag from "../../../components/Flag.astro";
import CarDescription from "../../../components/CarDescription.astro";
import { brand } from "../../../brands/index.ts";
import { getCar, listCars, specsLine, priceLabel, makeSlug, carFacts } from "../../../lib/cars.ts";
import { lightboxJson } from "../../../lib/lightbox.ts";
import { pageVideo } from "../../../lib/video.ts";
import { readEnquiryForm, saveEnquiry, DIAL_CODES, type Enquiry, type EnquiryErrors } from "../../../lib/leads.ts";
import { emailEnquiry } from "../../../lib/mail.ts";

const car = await getCar(Astro.params.slug ?? "");
if (!car) return new Response(null, { status: 404 });

const name = `${car.make} ${car.model}`;
const here = `/cars/${car.slug}/b`;

let values: Partial<Enquiry> = { dial: "+44", message: `I'm interested in the ${name}.` };
let errors: EnquiryErrors = {};
let failed = false;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  // Left empty by people; filled by bots. Bots get the thank-you anyway.
  if (String(form.get("website") ?? "")) return Astro.redirect(`${here}?sent=1#enquire`, 303);
  const read = readEnquiryForm(form);
  values = read.data;
  errors = read.errors;
  if (!Object.keys(errors).length) {
    try {
      const about = { id: car.id, name, url: `/cars/${car.slug}` };
      await saveEnquiry(read.data, about);
      emailEnquiry(read.data, about);
      return Astro.redirect(`${here}?sent=1#enquire`, 303);
    } catch {
      failed = true;
    }
  }
  Astro.response.status = 400;
}
const sent = Astro.url.searchParams.get("sent") === "1";

const facts = carFacts(car);
const others = (await listCars()).filter((c) => c.id !== car.id && c.status !== "sold").slice(0, 2);
const sales = brand.contact.phones[0];
const sell = brand.features.sellForm ? brand.copy.sell : undefined;

// The mosaic: the first photo large and the next four beside it, the last
// of those saying how many there are. Fewer than five photos: just the first.
// With a walkaround video, the tile beside the first photo is the video (its
// poster, one of the car's photos; the video loads only on play), so four
// photos are enough. A button by the price plays it too, and on phones (one
// photo) a "Video" button sits on the photo.
const video = pageVideo(car);
const n = car.photos.length;
const mosaic = n >= (video ? 4 : 5);
const shown = car.photos.slice(0, mosaic ? (video ? 4 : 5) : 1);

const err = (k: keyof Enquiry) => errors[k];
---

<Base title={name} description={specsLine(car)} noindex car={name}>
 <div class="car-page">
  <p class="wrap compare">Layout B, for comparison · <a href={`/cars/${car.slug}`}>See layout A</a></p>

  <div class="wrap gallery-wrap">
    {n > 0 && (
     <div class="gal">
      <section class:list={["mosaic", { single: !mosaic }]} aria-label="Photos">
        {car.photos.map((p, i) => (
          <>
          {i === 1 && video && mosaic && (
            <button type="button" class="tile vtile" data-video aria-label={video.label}>
              {video.poster && <CarPhoto photo={video.poster} fit="cover" sizes="(min-width: 1240px) 300px, 25vw" />}
              <span class="vshade" aria-hidden="true">
                <span class="vplay"><svg viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z" /></svg></span>
                Walkaround video{video.length && ` · ${video.length}`}
              </span>
            </button>
          )}
          <button
            type="button"
            class:list={["tile", { lead: i === 0, extra: i >= shown.length }]}
            data-i={i}
            aria-label={mosaic && i === shown.length - 1 ? `View all ${n} photos` : `Open photo ${i + 1} of ${n} full screen`}
          >
            <CarPhoto
              photo={p}
              fit="cover"
              priority={i === 0}
              alt={i === 0 ? (p.alt ?? `${name}, photo 1 of ${n}`) : ""}
              sizes={i === 0 ? "(min-width: 1240px) 600px, (min-width: 640px) 50vw, 100vw" : "(min-width: 1240px) 300px, (min-width: 640px) 25vw, 100vw"}
              style={i === 0 ? `view-transition-name: car-${car.id}` : undefined}
            />
            {mosaic && i === shown.length - 1 && (
              <span class="all" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" /></svg>
                View all {n} photos
              </span>
            )}
            {i === 0 && n > 1 && (
              <span class:list={["count", { always: !mosaic }]} aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" /></svg>
                {n} photos
              </span>
            )}
          </button>
          </>
        ))}
      </section>
      {video && (
        <button type="button" class="vpill" data-video aria-label={video.label}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" /></svg>
          Video{video.length && ` ${video.length}`}
        </button>
      )}
      {n > 1 && <span class="pos" aria-hidden="true"><span data-pos>1</span> / {n}</span>}
     </div>
    )}
    <script type="application/json" id="lightbox-photos" set:html={lightboxJson(car)} />
    {video && <script type="application/json" id="car-video" set:html={video.json} />}
  </div>

  <main class="wrap page">
    <div class="head">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/cars">All cars</a><span aria-hidden="true">/</span><a href={`/cars?make=${makeSlug(car.make)}`}>{car.make}</a>
        </nav>
        {car.status !== "available" && <span class="status">{car.status === "sold" ? "Sold" : "Reserved"}</span>}
        <h1>{name}</h1>
        <p class="specs">{specsLine(car)}</p>
      </div>
      <div class="buy">
        <p class="price">
          <span class="amount">{priceLabel(car)}</span>
          {!car.price && <span class="poa">Price on application</span>}
        </p>
        <div class="buy-btns">
          {video && (
            <button class="btn big watch" type="button" data-video>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path class="fill" d="M7 4.5v15l13-7.5z" /></svg>
              Watch video
            </button>
          )}
          {sales && (
            <a class="btn btn-primary big" href={`tel:${sales.tel}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
              Call {sales.display}
            </a>
          )}
          <a class="btn btn-dark big" href="#enquire">Enquire</a>
        </div>
      </div>
    </div>

    {facts.length > 0 && (
      <dl class="strip">
        {facts.map(([k, v]) => (
          <div><dt>{k}</dt><dd>{k === "Registered" && <Flag registered={car.registered} />}{v}</dd></div>
        ))}
      </dl>
    )}

    <div class="two">
      <section class="about" aria-labelledby="about-h">
        <h2 id="about-h">About this car</h2>
        {car.description && <CarDescription text={car.description} />}
      </section>

      <section id="enquire" class="enquire" aria-labelledby="enq-h">
        {sent ? (
          <div class="thanks" role="status">
            <h2 id="enq-h">Thank you</h2>
            <p>Your enquiry about the {name} has been sent.</p>
          </div>
        ) : (
          <form method="post" action={`${here}#enquire`} novalidate>
            <h2 id="enq-h">Ask about this car</h2>
            {failed && <p class="fail" role="alert">Sorry, that didn't send. Please try again, or call us.</p>}
            <div class="field">
              <label for="e-name">Name</label>
              <input id="e-name" name="name" autocomplete="name" value={values.name} aria-invalid={err("name") ? "true" : undefined} aria-describedby={err("name") ? "e-name-err" : undefined} />
              {err("name") && <p class="err" id="e-name-err">{err("name")}</p>}
            </div>
            <div class="field">
              <label for="e-email">Email</label>
              <input id="e-email" name="email" type="email" autocomplete="email" value={values.email} aria-invalid={err("email") ? "true" : undefined} aria-describedby={err("email") ? "e-email-err" : undefined} />
              {err("email") && <p class="err" id="e-email-err">{err("email")}</p>}
            </div>
            <div class="field">
              <label for="e-phone">Phone <span class="opt">(optional)</span></label>
              <div class="tel">
                <select name="dial" class="dial" aria-label="Country code">
                  {DIAL_CODES.map(([code]) => <option value={code} selected={values.dial === code}>{code}</option>)}
                </select>
                <input id="e-phone" name="phone" type="tel" autocomplete="tel-national" value={values.phone} aria-invalid={err("phone") ? "true" : undefined} aria-describedby={err("phone") ? "e-phone-err" : undefined} />
              </div>
              {err("phone") && <p class="err" id="e-phone-err">{err("phone")}</p>}
            </div>
            <div class="field">
              <label for="e-msg">Message</label>
              <textarea id="e-msg" name="message" rows="4" aria-invalid={err("message") ? "true" : undefined} aria-describedby={err("message") ? "e-msg-err" : undefined}>{values.message}</textarea>
              {err("message") && <p class="err" id="e-msg-err">{err("message")}</p>}
            </div>
            <div class="hp" aria-hidden="true">
              <label for="e-website">Leave this empty</label>
              <input id="e-website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <button class="btn btn-dark big send" type="submit">Send enquiry</button>
            {sales && <p class="or">Or call us on <a href={`tel:${sales.tel}`}>{sales.display}</a>.</p>}
          </form>
        )}
      </section>
    </div>
  </main>

  {sell && (
    <section class="sell">
      <div class="wrap sell-in">
        <div>
          <h2>{sell.bandHeading ?? "Got a car to sell?"}</h2>
          {sell.bandText && <p>{sell.bandText}</p>}
        </div>
        <div class="sell-btns">
          <a class="btn btn-light big" href="/sell-your-car">Get my free valuation</a>
          {brand.features.carsWanted && <a class="btn btn-ghost big" href="/cars-wanted">See the cars we want</a>}
        </div>
      </div>
    </section>
  )}

  {others.length > 0 && (
    <section class="wrap more" aria-labelledby="more-h">
      <h2 id="more-h">More cars in stock</h2>
      <div class="more-grid">
        {others.map((c) => <CarCard car={c} fit={brand.cardPhoto.fit} />)}
        <a class="all-cars" href="/cars">
          <strong>See all our cars</strong>
          <span>Every car we have in stock</span>
          <span class="go">Browse cars</span>
        </a>
      </div>
    </section>
  )}

  <div class="call-bar">
    {sales && <a class="btn big" href={`tel:${sales.tel}`}>Call</a>}
    <a class="btn btn-dark big" href="#enquire">Enquire</a>
  </div>
 </div>
</Base>

<script>
  import { openLightbox } from "../../../scripts/lightbox.ts";
  import { wireVideo } from "../../../scripts/video.ts";

  wireVideo();

  // Each photo opens full screen at that photo. On phones the photos are a
  // swipeable row: the counter follows it, and closing the full screen leaves
  // the row on the photo last viewed.
  const strip = document.querySelector<HTMLElement>(".mosaic");
  const pos = document.querySelector<HTMLElement>("[data-pos]");
  const swiping = () => !!strip && strip.scrollWidth > strip.clientWidth + 1;
  const at = () => (strip ? Math.round(strip.scrollLeft / strip.clientWidth) : 0);
  strip?.addEventListener(
    "scroll",
    () => {
      if (pos) pos.textContent = String(at() + 1);
    },
    { passive: true },
  );
  document.querySelectorAll<HTMLButtonElement>(".mosaic .tile:not(.vtile)").forEach((t) => {
    t.addEventListener("click", () =>
      openLightbox(Number(t.dataset.i ?? 0), (index) => {
        if (strip && swiping() && index !== at()) strip.scrollTo({ left: index * strip.clientWidth, behavior: "instant" });
      }),
    );
  });
</script>

<style>
  .compare {
    margin: 12px auto 0;
    font-size: 14px;
    color: var(--color-muted);
  }
  .gallery-wrap {
    margin-top: 12px;
  }
  .gal {
    position: relative;
  }
  /* Photos past the mosaic's: only in the phones' swipeable row. */
  .extra {
    display: none;
  }
  /* Desktop: one large photo and four small; phones: the large one only. */
  .mosaic {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 6px;
    aspect-ratio: 32 / 11;
  }
  .mosaic.single {
    display: block;
    aspect-ratio: 16 / 9;
    max-height: 640px;
  }
  .tile {
    position: relative;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: var(--color-line);
    cursor: zoom-in;
  }
  .single .tile {
    width: 100%;
    height: 100%;
  }
  .tile :global(img) {
    transition: transform 0.3s ease;
  }
  .tile:hover :global(img) {
    transform: scale(1.03);
  }
  .lead {
    grid-row: span 2;
  }
  .mosaic {
    position: relative;
  }
  /* The video's tile: its poster, darkened, with a play button. */
  .vtile {
    cursor: pointer;
  }
  .vshade {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 8px;
    background: color-mix(in srgb, var(--color-fg) 50%, transparent);
    color: #fff;
    font: 700 16px/1.2 var(--font-body);
    text-align: center;
  }
  .vplay {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #fff;
    color: var(--color-fg);
    box-shadow: 0 3px 12px rgb(0 0 0 / 0.35);
    transition: transform 0.2s ease;
  }
  .vtile:hover .vplay {
    transform: scale(1.08);
  }
  .vplay svg {
    width: 26px;
    height: 26px;
    margin-left: 4px;
    fill: currentColor;
  }
  /* On one photo (phones, or few photos): a "Video" button on it. */
  .vpill {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: none;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 14px 0 12px;
    border: 0;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font: 700 14px/1 var(--font-body);
    box-shadow: 0 1px 4px color-mix(in srgb, var(--color-fg) 30%, transparent);
    cursor: pointer;
  }
  .vpill svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }
  .single + .vpill {
    display: inline-flex;
  }
  .watch .fill {
    fill: currentColor;
    stroke: none;
  }
  .all,
  .count {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 700 15px/1 var(--font-body);
    box-shadow: 0 1px 4px color-mix(in srgb, var(--color-fg) 30%, transparent);
  }
  .all {
    right: 14px;
    bottom: 14px;
    height: 40px;
    padding: 0 16px;
    background: var(--color-surface);
    color: var(--color-fg);
  }
  .count {
    display: none;
    right: 12px;
    bottom: 12px;
    height: 34px;
    padding: 0 12px;
    background: var(--color-surface);
    color: var(--color-fg);
    font-size: 14px;
  }
  .count.always {
    display: inline-flex;
  }
  .all svg,
  .count svg,
  .big svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* The photo number on phones, kept in step by the script. */
  .pos {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: none;
    height: 30px;
    padding: 0 10px;
    line-height: 30px;
    white-space: pre;
    background: color-mix(in srgb, var(--color-fg) 70%, transparent);
    color: #fff;
    font: 700 14px/1 var(--font-body);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  /* Phones: every photo, edge to edge, in a row to swipe through. */
  @media (max-width: 639px) {
    .gallery-wrap {
      padding-inline: 0;
    }
    .mosaic,
    .mosaic.single {
      display: flex;
      aspect-ratio: 4 / 3;
      max-height: none;
      gap: 0;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .mosaic::-webkit-scrollbar {
      display: none;
    }
    .mosaic .tile,
    .mosaic .extra {
      display: block;
      flex: 0 0 100%;
      height: 100%;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
    .mosaic .vtile,
    .mosaic .all,
    .mosaic .count.always {
      display: none;
    }
    .tile:hover :global(img) {
      transform: none;
    }
    .vpill {
      display: inline-flex;
    }
    /* Without the script the counter can't follow, so it says how many. */
    .pos {
      display: none;
    }
    :global(html.js) .pos {
      display: block;
    }
    :global(html:not(.js)) .mosaic .lead .count {
      display: inline-flex;
    }
  }

  .page {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 28px;
    padding-bottom: 64px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px 32px;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 15px;
    color: var(--color-muted);
  }
  .crumbs a {
    color: var(--color-muted);
  }
  .status {
    display: inline-block;
    margin-top: 12px;
    padding: 6px 10px;
    background: var(--color-fg);
    color: var(--color-surface);
    font: 700 12px/1 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1 {
    font: 700 clamp(36px, 5vw, 56px)/1.02 var(--font-display);
    margin: 8px 0 0;
    overflow-wrap: anywhere;
  }
  .specs {
    margin: 6px 0 0;
    color: var(--color-muted);
    font-size: 18px;
  }
  .buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 20px;
  }
  .price {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }
  .amount {
    font: 700 44px/1 var(--font-display);
  }
  .poa {
    color: var(--color-muted);
    font-size: 14px;
  }
  .buy-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .big {
    min-height: 50px;
    font-weight: 700;
    border-width: 1.5px;
  }
  .btn-dark {
    background: var(--color-fg);
    border-color: var(--color-fg);
    color: var(--color-surface);
  }
  .btn-light {
    background: var(--color-band-fg);
    border-color: var(--color-band-fg);
    color: var(--color-band);
  }
  .btn-ghost {
    border-color: color-mix(in srgb, var(--color-band-fg) 70%, transparent);
    color: var(--color-band-fg);
  }
  @media (max-width: 639px) {
    .buy,
    .buy-btns {
      width: 100%;
    }
    .price {
      align-items: flex-start;
    }
    .buy-btns {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
    }
    .buy-btns .btn-dark {
      display: none;
    }
  }

  /* The key facts in large numbers. */
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    margin: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  .strip div {
    padding: 16px 20px;
    border-right: 1px solid var(--color-line);
    margin-right: -1px;
  }
  .strip dt {
    font: 700 12px/1.3 var(--font-body);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .strip dd {
    margin: 4px 0 0;
    font: 700 26px/1.1 var(--font-display);
    overflow-wrap: anywhere;
  }
  /* As tall as the capitals beside it. */
  .strip dd :global(.flag) {
    width: 24px;
    height: 18px;
    vertical-align: 0;
  }
  @media (max-width: 639px) {
    .strip {
      grid-template-columns: 1fr 1fr;
    }
    .strip div {
      margin-right: 0;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .strip div:nth-child(odd) {
      border-right: 1px solid var(--color-line);
    }
  }

  .two {
    display: grid;
    gap: 32px 48px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .two {
      grid-template-columns: minmax(0, 1fr) 420px;
    }
  }
  .about h2,
  .enquire h2,
  .more h2 {
    font: 700 30px/1.1 var(--font-display);
    margin: 0 0 14px;
  }
  .about {
    font-size: 18px;
  }

  /* The enquiry form, in the sell page's plain style. */
  .enquire {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    padding: 28px;
    scroll-margin-top: 16px;
  }
  @media (max-width: 639px) {
    .enquire {
      padding: 22px 18px;
    }
  }
  form {
    display: flex;
    flex-direction: column;
