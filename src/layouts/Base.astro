---
import "../styles/global.css";
import { brand, brandCss } from "../brands/index.ts";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";

// Every brand's @font-face rules are bundled; a browser only downloads the
// files of fonts the page actually uses, so other brands' fonts cost nothing.
const fontModules = import.meta.glob<{ preload: string[] }>("../brands/fonts/*.ts", { eager: true });
const preloadFonts = fontModules[`../brands/fonts/${brand.id}.ts`]?.preload ?? [];

// A plain square icon from the brand: its accent colour and first letter.
const icon =
  "data:image/svg+xml," +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" fill="${brand.colors.light.accent}"/>` +
      `<text x="16" y="23" font-family="Arial,sans-serif" font-weight="700" font-size="20" text-anchor="middle" fill="${brand.colors.light.accentInk}">${brand.logo.top.charAt(0)}</text></svg>`,
  );

interface Props {
  title: string;
  description?: string;
  /** Keep the page out of search engines (layouts being compared, etc.). */
  noindex?: boolean;
  /** The page ends in a full-width band: no gap above the footer. */
  flush?: boolean;
  /** The car the page is about, for the WhatsApp button's message. */
  car?: string;
}
const { title, description, noindex = false, flush = false, car } = Astro.props;
const path = Astro.url.pathname;
const sales = brand.contact.phones[0];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} | {brand.name}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={icon} />
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={brandCss()}></style>
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <header class="site-head">
      <div class="wrap bar">
        <a class="logo" href="/" aria-label={`${brand.name} home`}>
          <span class="top">{brand.logo.top}</span>
          <span class="bottom">{brand.logo.bottom}</span>
        </a>
        <!-- Shown only on phones with scripts running (CSS below). -->
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="main-nav">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          Menu
        </button>
        <nav id="main-nav" aria-label="Main">
          <a href="/cars" aria-current={path.startsWith("/cars") ? "page" : undefined}>Cars</a>
          {brand.features.sellForm && (
            <a href="/sell-your-car" aria-current={path === "/sell-your-car" ? "page" : undefined}>Sell your car</a>
          )}
          {brand.features.blog && <a href="/blog" aria-current={path.startsWith("/blog") ? "page" : undefined}>Blog</a>}
          {brand.copy.about && <a href="/about" aria-current={path === "/about" ? "page" : undefined}>About</a>}
          <a href="/contact" aria-current={path === "/contact" ? "page" : undefined}>Contact</a>
          {sales && <a class="tel" href={`tel:${sales.tel}`}>{sales.display}</a>}
        </nav>
      </div>
    </header>

    <slot />

    <footer class:list={["site-foot", { flush }]}>
      <div class:list={["wrap cols", { beside: brand.contact.whatsapp }]}>
        <div>
          <div class="eyebrow">{brand.name}</div>
          <p>{brand.contact.address}</p>
          <p>{brand.contact.hours}{brand.contact.viewings && <>. {brand.contact.viewings}</>}</p>
        </div>
        <ul>
          {brand.contact.phones.map((p) => (
            <li>{p.label}: <a href={`tel:${p.tel}`}>{p.display}</a></li>
          ))}
          <li><a href={`mailto:${brand.contact.email}`}>{brand.contact.email}</a></li>
        </ul>
      </div>
    </footer>

    <WhatsAppFloat car={car} />
  </body>
</html>

<script>
  // Phones: the Menu button opens and closes the links.
  const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
  const nav = document.getElementById("main-nav");
  btn?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open") ?? false;
    btn.setAttribute("aria-expanded", String(open));
  });
</script>

<style>
  .site-head {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
  }
  .logo {
    display: grid;
    line-height: 1;
    text-decoration: none;
    color: var(--color-fg);
  }
  .logo .top {
    font: 700 26px/0.95 var(--font-display);
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }
  .logo .bottom {
    font: 600 11px/1.3 var(--font-display);
    letter-spacing: 0.14em;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px 20px;
    align-items: center;
    font-weight: 600;
  }
  .menu-btn {
    display: none;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-fg);
    font: 600 15px/1 var(--font-body);
    cursor: pointer;
  }
  .menu-btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  /* Phones (with scripts): the links behind a Menu button, opening as a list
     under the bar. Without scripts they simply wrap. */
  @media (max-width: 899px) {
    :global(.js) .menu-btn {
      display: inline-flex;
    }
    :global(.js) .bar {
      flex-wrap: wrap;
    }
    :global(.js) nav {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-bottom: 8px;
    }
    :global(.js) nav.open {
      display: flex;
    }
    :global(.js) nav a {
      padding-block: 12px;
      border-bottom: 1px solid var(--color-line);
    }
    :global(.js) nav a[aria-current="page"] {
      border-bottom-color: var(--color-line);
      color: var(--color-accent);
    }
  }
  nav a {
    color: var(--color-fg);
    text-decoration: none;
    padding-block: 8px;
    border-bottom: 2px solid transparent;
  }
  nav a[aria-current="page"] {
    border-color: var(--color-accent);
  }
  nav .tel {
    font-variant-numeric: tabular-nums;
  }
  .site-foot.flush {
    margin-top: 0;
  }
  .site-foot {
    margin-top: 64px;
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: 15px;
  }
  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    justify-content: space-between;
    padding-block: 32px calc(32px + env(safe-area-inset-bottom, 0px));
  }
  /* The WhatsApp button (56px, 16px from the edge) is beside the text, never
     over it. Wider screens have room in the margin. */
  @media (max-width: 1351px) {
    .cols.beside {
      padding-right: calc(88px + env(safe-area-inset-right, 0px));
    }
  }
  .cols p,
  .cols ul {
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }
  .cols a {
    color: var(--color-fg);
  }
  /* Room to tap each link on a phone. */
  .cols li {
    padding-block: 6px;
  }
</style>
