---
import "../styles/global.css";
import { brand, brandCss } from "../brands/index.ts";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";

// Every brand's @font-face rules are bundled; a browser only downloads the
// files of fonts the page actually uses, so other brands' fonts cost nothing.
const fontModules = import.meta.glob<{ preload: string[] }>("../brands/fonts/*.ts", { eager: true });
const preloadFonts = fontModules[`../brands/fonts/${brand.id}.ts`]?.preload ?? [];

// A plain square icon from the brand: its accent colour and first letter.
const icon =
  "data:image/svg+xml," +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" fill="${brand.colors.light.accent}"/>` +
      `<text x="16" y="23" font-family="Arial,sans-serif" font-weight="700" font-size="20" text-anchor="middle" fill="${brand.colors.light.accentInk}">${brand.logo.top.charAt(0)}</text></svg>`,
  );

interface Props {
  title: string;
  description?: string;
  /** Keep the page out of search engines (layouts being compared, etc.). */
  noindex?: boolean;
  /** The page ends in a full-width band: no gap above the footer. */
  flush?: boolean;
  /** The car the page is about, for the WhatsApp button's message. */
  car?: string;
}
const { title, description, noindex = false, flush = false, car } = Astro.props;
const path = Astro.url.pathname;
const sales = brand.contact.phones[0];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} | {brand.name}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={icon} />
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={brandCss()}></style>
    <script is:inline>document.documentElement.classList.add("js");</script>
    <script is:inline>
      // After a form is sent, its thank-you shows at ?sent=1 (posting and
      // then redirecting, so a refresh can't send it twice). Take that off the
      // address once shown, so a refresh or a shared link gives the page as
      // normal; ?again ("Send another message") goes too.
      (() => {
        const u = new URL(location.href);
        const had = ["sent", "again"].filter((k) => u.searchParams.has(k));
        had.forEach((k) => u.searchParams.delete(k));
        if (had.length) history.replaceState(history.state, "", u.pathname + u.search + u.hash);
      })();
    </script>
  </head>
  <body>
    <header class="site-head">
      <div class="wrap bar">
        <a class="logo" href="/" aria-label={`${brand.name} home`}>
          <span class="top">{brand.logo.top}</span>
          <span class="bottom">{brand.logo.bottom}</span>
        </a>
        <!-- Shown only on phones with scripts running (CSS below). -->
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="main-nav">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path class="bars" d="M4 7h16M4 12h16M4 17h16" /><path class="cross" d="M6 6l12 12M18 6L6 18" /></svg>
          Menu
        </button>
        <nav id="main-nav" aria-label="Main">
          <a href="/cars" aria-current={path.startsWith("/cars") ? "page" : undefined}>Cars</a>
          {brand.features.sellForm && (
            <a href="/sell-your-car" aria-current={path.startsWith("/sell-your-car") ? "page" : undefined}>Sell your car</a>
          )}
          {brand.features.blog && <a href="/blog" aria-current={path.startsWith("/blog") ? "page" : undefined}>Blog</a>}
          {brand.copy.about && <a href="/about" aria-current={path === "/about" ? "page" : undefined}>About</a>}
          <a href="/contact" aria-current={path === "/contact" ? "page" : undefined}>Contact</a>
          {sales && <a class="tel" href={`tel:${sales.tel}`}>{sales.display}</a>}
        </nav>
      </div>
    </header>

    <slot />

    <Footer flush={flush} />

    <WhatsAppFloat car={car} />
  </body>
</html>

<script>
  // Phones: the Menu button opens and closes the links.
  const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
  const nav = document.getElementById("main-nav");
  const show = (open: boolean) => {
    nav?.classList.toggle("open", open);
    btn?.setAttribute("aria-expanded", String(open));
  };
  btn?.addEventListener("click", () => show(!nav?.classList.contains("open")));
  // Escape closes it, back on the button.
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape" || !nav?.classList.contains("open")) return;
    show(false);
    btn?.focus();
  });
</script>

<style>
  /* A page shorter than the screen: the footer's colour carries on below it. */
  :global(html) {
    background: var(--color-foot);
  }
  .site-head {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
  }
  .logo {
    display: grid;
    line-height: 1;
    text-decoration: none;
    color: var(--color-fg);
  }
  .logo .top {
    font: 700 26px/0.95 var(--font-display);
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }
  .logo .bottom {
    font: 600 11px/1.3 var(--font-display);
    letter-spacing: 0.14em;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px 20px;
    align-items: center;
    font-weight: 600;
  }
  .menu-btn {
    display: none;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-fg);
    font: 600 15px/1 var(--font-body);
    cursor: pointer;
  }
  .menu-btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  /* ☰ when closed, × when open. */
  .menu-btn .cross,
  .menu-btn[aria-expanded="true"] .bars {
    display: none;
  }
  .menu-btn[aria-expanded="true"] .cross {
    display: inline;
  }
  /* Phones (with scripts): the links behind a Menu button, opening as a list
     under the bar. Without scripts they simply wrap. */
  @media (max-width: 899px) {
    :global(.js) .menu-btn {
      display: inline-flex;
    }
    :global(.js) .bar {
      flex-wrap: wrap;
      row-gap: 0;
    }
    /* The top row keeps its height when the links open below it, so the
       logo and button don't move. */
    :global(.js) .logo {
      min-height: 64px;
      align-content: center;
    }
    :global(.js) nav {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      border-top: 1px solid var(--color-line);
    }
    :global(.js) nav.open {
      display: flex;
    }
    :global(.js) nav a {
      padding-block: 12px;
      border-bottom: 1px solid var(--color-line);
    }
    /* The header's own line closes the list. */
    :global(.js) nav a:last-child {
      border-bottom: 0;
    }
    :global(.js) nav a[aria-current="page"] {
      border-bottom-color: var(--color-line);
      color: var(--color-accent);
    }
  }
  nav a {
    color: var(--color-fg);
    text-decoration: none;
    padding-block: 8px;
    border-bottom: 2px solid transparent;
  }
  nav a[aria-current="page"] {
    border-color: var(--color-accent);
  }
  nav .tel {
    font-variant-numeric: tabular-nums;
  }
</style>
