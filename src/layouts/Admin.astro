---
// The admin's frame, from the admin mockups: a dark sidebar on computers
// that becomes tabs along the bottom on phones. Brand colours and fonts as
// on the site; never indexed (the middleware also sends X-Robots-Tag).
import "../styles/global.css";
import { brand, brandCss } from "../brands/index.ts";
import { listLeads } from "../lib/leads.ts";

interface Props {
  title: string;
  active?: "cars" | "blog" | "landing" | "photos" | "leads";
}
const { title, active } = Astro.props;

const fontModules = import.meta.glob<{ preload: string[] }>("../brands/fonts/*.ts", { eager: true });
const preloadFonts = fontModules[`../brands/fonts/${brand.id}.ts`]?.preload ?? [];

const newLeads = (await Promise.all([listLeads("sell"), listLeads("enquiries"), listLeads("messages")]))
  .flat()
  .filter((l) => l.admin.stage === "New").length;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | {brand.name} admin</title>
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={brandCss()}></style>
  </head>
  <body>
    <div class="frame">
      <nav class="side" aria-label="Admin">
        <a class="logo" href="/admin/cars">
          <span class="top">{brand.logo.top}</span>
          <span class="bottom">{brand.logo.bottom} · Admin</span>
        </a>
        <a class="item" href="/admin/cars" aria-current={active === "cars" ? "page" : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 17h14M6 17l1.5-6h9L18 17M8 11l1-3h6l1 3" /><circle cx="8" cy="17" r="1.5" /><circle cx="16" cy="17" r="1.5" /></svg>
          <span>Cars</span>
        </a>
        {brand.features.blog && (
          <a class="item" href="/admin/blog" aria-current={active === "blog" ? "page" : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5" /></svg>
            <span>Blog</span>
          </a>
        )}
        <a class="item" href="/admin/landing" aria-current={active === "landing" ? "page" : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4zM4 9h16M8 13h8M8 16h5" /></svg>
          <span>Landing</span>
        </a>
        <a class="item" href="/admin/photos" aria-current={active === "photos" ? "page" : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4z" /><path d="m4 16 5-5 4 4 3-3 4 4" /><circle cx="15.5" cy="9" r="1.5" /></svg>
          <span>Photos</span>
        </a>
        <a class="item" href="/admin/leads" aria-current={active === "leads" ? "page" : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4z" /><path d="m4 7 8 6 8-6" /></svg>
          <span>Leads</span>
          {newLeads > 0 && <span class="badge" aria-label={`${newLeads} new`}>{newLeads}</span>}
        </a>
        <a class="item" href="/" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6" /></svg>
          <span>View the site</span>
        </a>
        <form method="post" action="/admin/logout" class="out">
          <button class="item" type="submit">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h10" /></svg>
            <span>Sign out</span>
          </button>
        </form>
      </nav>

      <main class="main">
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  /* Shared by the admin pages. */
  .admin-h1 {
    font: 700 clamp(32px, 4vw, 40px)/1.05 var(--font-display);
    margin: 0;
  }
  .admin-box {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .admin-box > h2 {
    font: 700 24px/1.1 var(--font-display);
    margin: 0;
  }
  @media (max-width: 639px) {
    .admin-box {
      padding: 18px 16px;
    }
  }
  .a-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    font: 700 15px/1 var(--font-body);
    text-decoration: none;
    border: 1.5px solid var(--color-fg);
    background: var(--color-surface);
    color: var(--color-fg);
    cursor: pointer;
  }
  .a-btn.pri {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }
  .a-btn svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .a-lbl {
    display: block;
    margin: 0 0 6px;
    font-weight: 600;
    font-size: 14px;
  }
  .a-opt {
    font-weight: 400;
    color: var(--color-muted);
  }
  .a-in {
    display: block;
    width: 100%;
    box-sizing: border-box;
    min-height: 46px;
    padding: 0 12px;
    border: 1px solid var(--color-muted);
    background: var(--color-surface);
    color: var(--color-fg);
    font: 400 16px/1.4 var(--font-body);
  }
  textarea.a-in {
    padding: 10px 12px;
    resize: vertical;
  }
  .a-in:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .a-hint {
    margin: 6px 0 0;
    font-size: 13px;
    color: var(--color-muted);
  }
  .a-err {
    margin: 6px 0 0;
    color: #b42318;
    font-size: 14px;
    font-weight: 600;
  }
  .a-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  /* Radio pills: a real radio, hidden, with its label as the pill. */
  .a-pill input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .a-pill span {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 14px;
    border: 1px solid var(--color-muted);
    background: var(--color-surface);
    font-weight: 600;
    cursor: pointer;
  }
  .a-pill input:checked + span {
    background: var(--color-fg);
    border-color: var(--color-fg);
    color: var(--color-surface);
  }
  .a-pill input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .a-chip {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 9px;
    font: 700 12px/1 var(--font-body);
    white-space: nowrap;
  }
  .a-chip.available {
    background: color-mix(in srgb, var(--color-accent) 16%, var(--color-surface));
    color: var(--color-fg);
  }
  .a-chip.reserved {
    background: #fdf0d5;
    color: #7a4b00;
  }
  .a-chip.sold {
    background: var(--color-fg);
    color: var(--color-surface);
  }
  .a-chip.draft {
    background: var(--color-line);
    color: var(--color-fg);
  }
  .a-note {
    padding: 12px 16px;
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
    border: 1px solid var(--color-line);
  }
</style>

<style>
  .frame {
    display: flex;
    min-height: 100vh;
  }
  .side {
    flex: 0 0 232px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 14px;
    background: var(--color-band);
    color: var(--color-band-fg);
  }
  .logo {
    display: grid;
    padding: 4px 12px 20px;
    text-decoration: none;
    color: var(--color-band-fg);
    line-height: 1;
  }
  .logo .top {
    font: 700 26px/0.95 var(--font-display);
    letter-spacing: 0.06em;
  }
  .logo .bottom {
    font: 600 11px/1.3 var(--font-display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .item {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 44px;
    padding: 0 12px;
    border: 0;
    background: none;
    color: var(--color-band-muted);
    font: 600 15px/1 var(--font-body);
    text-decoration: none;
    cursor: pointer;
  }
  .item:hover {
    color: var(--color-band-fg);
    background: color-mix(in srgb, var(--color-band-fg) 10%, transparent);
  }
  .item[aria-current="page"] {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }
  .item svg {
    width: 18px;
    height: 18px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .badge {
    margin-left: auto;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 11px;
    background: #f0b429;
    color: #16181d;
    font: 700 12px/22px var(--font-body);
    text-align: center;
  }
  .out {
    margin-top: auto;
  }
  .main {
    flex: 1;
    min-width: 0;
    padding: 24px 32px 48px;
  }

  /* Phones: the sidebar becomes tabs along the bottom of the screen. */
  @media (max-width: 799px) {
    .frame {
      display: block;
    }
    .main {
      padding: 18px 16px calc(88px + env(safe-area-inset-bottom, 0px));
    }
    .side {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 20;
      flex-direction: row;
      gap: 0;
      padding: 0 0 env(safe-area-inset-bottom, 0px);
      border-top: 1px solid var(--color-line);
      background: var(--color-surface);
    }
    .logo {
      display: none;
    }
    .side > .item,
    .out {
      flex: 1;
      margin: 0;
    }
    .item {
      position: relative;
      flex-direction: column;
      justify-content: center;
      gap: 3px;
      min-height: 62px;
      padding: 0 4px;
      color: var(--color-muted);
      font-size: 12px;
    }
    .item:hover {
      color: var(--color-fg);
      background: none;
    }
    .item[aria-current="page"] {
      background: none;
      color: var(--color-accent);
    }
    .item svg {
      width: 22px;
      height: 22px;
    }
    .badge {
      position: absolute;
      top: 6px;
      left: calc(50% + 6px);
      min-width: 18px;
      height: 18px;
      font-size: 11px;
      line-height: 18px;
      border-radius: 9px;
    }
  }
</style>
