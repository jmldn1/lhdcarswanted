# Copy to .env and fill in. .env is never committed.

# This site's own MongoDB database (never another project's).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=lhdcarswanted

# Set both with: npm run admin:password
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Optional: where things are kept (defaults in brackets)
# DATA_DIR=        (data)
# LEADS_DIR=       (data/leads)
# PHOTO_DIR=       (public/photos)

# Optional: the admin's AI writing help (Anthropic's Claude). Without a key
# the AI buttons don't show. Key from https://platform.claude.com
# ANTHROPIC_API_KEY=
# The model, and the most AI requests a day (a cap on spending). The values
# shown are the defaults; set them only to change them.
# AI_MODEL=claude-opus-5-5
# AI_DAILY_LIMIT=300

# Optional: emails the dealer each sell request, enquiry and message, through Gmail.
# GMAIL_PASS is an app password (Google account, Security), not the account's
# own. GMAIL_TO: one address, or several separated by commas.
# GMAIL_USER=
# GMAIL_PASS=
# GMAIL_TO=

# Optional: the landing pages' registration lookup (DVLA Vehicle Enquiry
# Service, and the DVSA MOT history API for the model and last mileage).
# Without DVLA_API_KEY the landing pages show the full form instead.
# DVLA_API_KEY=
# MOT_API_KEY=
# DVSA_TENANT_ID=
# DVSA_CLIENT_ID=
# DVSA_CLIENT_SECRET=

# Optional: Google reviews on the About page (Admin, Reviews). An OAuth client
# of type "Web application" from a Google Cloud project approved for the
# Business Profile APIs; its "Authorised redirect URIs" must include
# https://<this site>/admin/google/callback. London LHD Centre's client can be
# used: the account that clicks Connect decides whose reviews come back.
# GOOGLE_REDIRECT_URI forces the return address; GOOGLE_TOKEN_KEY encrypts the
# saved permission (SESSION_SECRET is used without it).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_TOKEN_KEY=
