# Copy to .env and fill in. .env is never committed.

# This site's own MongoDB database (never another project's).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=lhdcarswanted

# Set both with: npm run admin:password
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Optional: where things are kept (defaults in brackets)
# DATA_DIR=        (data)
# LEADS_DIR=       (data/leads)
# PHOTO_DIR=       (public/photos)
